generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "windows", "debian-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Workspace {
  id                String             @id @default(uuid())
  name              String
  ownerId           String             @map("owner_id")
  plan              String             @default("free")
  stripeCustomerId       String?            @map("stripe_customer_id")
  stripeSubscriptionId   String?            @map("stripe_subscription_id")
  subscriptionStatus     String?            @default("inactive") @map("subscription_status")
  creditsUsed            Int                @default(0) @map("credits_used")
  creditsLimit           Int                @default(500) @map("credits_limit")
  createdAt         DateTime           @default(now()) @map("created_at")
  updatedAt         DateTime           @updatedAt @map("updated_at")
  members           WorkspaceMember[]
  agents            Agent[]
  contacts          Contact[]
  companies         Company[]
  deals             Deal[]
  apiKeys           ApiKey[]
  integrations      Integration[]
  appointments      Appointment[]
  conversations     Conversation[]
  pipelines         Pipeline[]
  tasks             Task[]
  smartLists        SmartList[]
  notifications     Notification[]
  customFields      CustomField[]
  tags              Tag[]
  webhookEndpoints  WebhookEndpoint[]
  attachments       Attachment[]
  wonLostReasons          WonLostReason[]
  opportunitySavedViews   OpportunitySavedView[]
  opportunityActivityLogs OpportunityActivityLog[]
  automationFolders AutomationFolder[]
  automationTables  AutomationTable[]
  Release           Release[]
  workflows         Workflow[]
  workflowRuns      WorkflowRun[]

  // Native workflow engine relations
  workflowCredentials     WorkflowCredential[]
  workflowSchedules       WorkflowSchedule[]
  workflowWebhooks        WorkflowWebhook[]
  crmTriggerSubscriptions CrmTriggerSubscription[]
  channelConnections      ChannelConnection[]

  // Ad Manager relations
  adAccounts          AdAccount[]
  adCampaigns         AdCampaign[]
  adLeads             AdLead[]
  adWorkspaceSettings AdWorkspaceSettings?

  // Lead Studio relations
  leadJobs        LeadGenerationJob[]
  leads           Lead[]
  userLeadHistory UserLeadHistory[]
  dailyLeadQuotas DailyLeadQuota[]

  // Inbox feature
  inboxToken              String?              @unique @map("inbox_token")
  inboxEnabled            Boolean              @default(false) @map("inbox_enabled")
  inboxChannels           InboxChannel[]
  inboxLabels             InboxLabel[]
  inboxTeams              InboxTeam[]
  cannedResponses         CannedResponse[]
  inboxConversations      InboxConversation[]
  inboxContacts           InboxContact[]
  inboxAgentSignatures    InboxAgentSignature[]

  // Help Center
  helpCenterPortal        HelpCenterPortal?

  // Contact Segments & Campaigns
  contactSegments         ContactSegment[]
  inboxCampaigns          InboxCampaign[]

  // Email Marketing relations
  emailLists                  EmailList[]
  contactListMemberships       ContactListMembership[]
  emailSegments               Segment[]
  emailTemplates              EmailTemplate[]
  emailCampaigns              Campaign[]
  emailAutomations            Automation[]
  emailAutomationEnrollments  AutomationEnrollment[]
  emailEvents                 EmailEvent[]
  emailSuppressionEntries     SuppressionEntry[]
  sendingDomains              SendingDomain[]
  aiActions                   AIAction[]
  sdrAgents                   AutonomousSdrAgent[]

  @@map("workspaces")
}

// ─── AI Action Queue ─────────────────────────────────────────────────────────

model AIAction {
  id           String   @id @default(uuid())
  workspaceId  String   @map("workspace_id")
  toolName     String   @map("tool_name")
  args         Json
  label        String
  status       String   @default("pending") // pending | approved | rejected
  result       Json?
  chatContext  String?  @map("chat_context")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")
  workspace    Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@map("ai_actions")
}

// ─── Inbox Models ────────────────────────────────────────────────────────────

model InboxChannel {
  id                  String    @id @default(uuid())
  workspaceId         String    @map("workspace_id")
  name                String
  channelType         String    @map("channel_type")
  avatarUrl           String?   @map("avatar_url")
  welcomeMessage      String?   @map("welcome_message")
  awayMessage         String?   @map("away_message")
  widgetColor         String    @default("#7dd3fc") @map("widget_color")
  isEnabled           Boolean   @default(true) @map("is_enabled")
  channelConnectionId String?   @map("channel_connection_id")
  embedToken          String?   @unique @map("embed_token")
  settingsJson        String    @default("{}") @map("settings_json")
  createdAt           DateTime  @default(now()) @map("created_at")
  updatedAt           DateTime  @updatedAt @map("updated_at")
  workspace           Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  conversations       InboxConversation[]
  agents              InboxChannelAgent[]
  campaigns           InboxCampaign[]

  @@index([workspaceId])
  @@map("inbox_channels")
}

model InboxChannelAgent {
  inboxChannelId     String       @map("inbox_channel_id")
  userId             String       @map("user_id")
  availabilityStatus String       @default("online") @map("availability_status")
  inboxChannel       InboxChannel @relation(fields: [inboxChannelId], references: [id], onDelete: Cascade)

  @@id([inboxChannelId, userId])
  @@map("inbox_channel_agents")
}

model InboxLabel {
  id             String    @id @default(uuid())
  workspaceId    String    @map("workspace_id")
  title          String
  description    String?
  color          String    @default("#7dd3fc")
  showOnSidebar  Boolean   @default(true) @map("show_on_sidebar")
  createdAt      DateTime  @default(now()) @map("created_at")
  workspace      Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  conversationLabels InboxConversationLabel[]

  @@unique([workspaceId, title])
  @@map("inbox_labels")
}

model InboxTeam {
  id            String    @id @default(uuid())
  workspaceId   String    @map("workspace_id")
  name          String
  description   String?
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")
  workspace     Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  members       InboxTeamMember[]
  conversations InboxConversation[]

  @@unique([workspaceId, name])
  @@map("inbox_teams")
}

model InboxTeamMember {
  teamId    String    @map("team_id")
  userId    String    @map("user_id")
  createdAt DateTime  @default(now()) @map("created_at")
  team      InboxTeam @relation(fields: [teamId], references: [id], onDelete: Cascade)

  @@id([teamId, userId])
  @@map("inbox_team_members")
}

model CannedResponse {
  id          String    @id @default(uuid())
  workspaceId String    @map("workspace_id")
  name        String
  content     String
  type        String    @default("text")
  folder      String?
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([workspaceId])
  @@map("canned_responses")
}

model InboxContact {
  id                   String    @id @default(uuid())
  workspaceId          String    @map("workspace_id")
  crmContactId         String?   @map("crm_contact_id")
  name                 String?
  email                String?
  phone                String?
  avatarUrl            String?   @map("avatar_url")
  externalId           String?   @map("external_id")
  additionalAttributes String?   @map("additional_attributes")
  lastActivityAt       DateTime? @map("last_activity_at")
  createdAt            DateTime  @default(now()) @map("created_at")
  updatedAt            DateTime  @updatedAt @map("updated_at")
  workspace            Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  conversations        InboxConversation[]

  @@index([workspaceId])
  @@index([externalId])
  @@map("inbox_contacts")
}

model InboxConversation {
  id                   String    @id @default(uuid())
  workspaceId          String    @map("workspace_id")
  inboxChannelId       String    @map("inbox_channel_id")
  inboxContactId       String?   @map("inbox_contact_id")
  crmContactId         String?   @map("crm_contact_id")
  displayId            Int       @map("display_id")
  status               String    @default("open")
  priority             String?
  subject              String?
  assignedUserId       String?   @map("assigned_user_id")
  teamId               String?   @map("team_id")
  snoozedUntil         DateTime? @map("snoozed_until")
  firstReplyAt         DateTime? @map("first_reply_at")
  resolvedAt           DateTime? @map("resolved_at")
  waitingSince         DateTime? @map("waiting_since")
  unreadCount          Int       @default(0) @map("unread_count")
  lastActivityAt       DateTime? @map("last_activity_at")
  additionalAttributes String?   @map("additional_attributes")
  createdAt            DateTime  @default(now()) @map("created_at")
  updatedAt            DateTime  @updatedAt @map("updated_at")

  workspace    Workspace     @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  inboxChannel InboxChannel  @relation(fields: [inboxChannelId], references: [id], onDelete: Cascade)
  inboxContact InboxContact? @relation(fields: [inboxContactId], references: [id], onDelete: SetNull)
  team         InboxTeam?    @relation(fields: [teamId], references: [id], onDelete: SetNull)
  messages     InboxMessage[]
  labels       InboxConversationLabel[]
  participants InboxConversationParticipant[]

  @@index([workspaceId])
  @@index([inboxChannelId])
  @@index([status])
  @@index([assignedUserId])
  @@map("inbox_conversations")
}

model InboxMessage {
  id                String    @id @default(uuid())
  conversationId    String    @map("conversation_id")
  workspaceId       String    @map("workspace_id")
  senderType        String    @map("sender_type")
  senderId          String?   @map("sender_id")
  contentType       String    @default("text") @map("content_type")
  content           String
  contentAttributes String?   @map("content_attributes")
  private           Boolean   @default(false)
  status            String    @default("sent")
  externalId        String?   @map("external_id")
  createdAt         DateTime  @default(now()) @map("created_at")
  updatedAt         DateTime  @updatedAt @map("updated_at")
  conversation      InboxConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  mentions          InboxMention[]

  @@index([conversationId])
  @@index([workspaceId])
  @@map("inbox_messages")
}

model InboxConversationLabel {
  conversationId String            @map("conversation_id")
  labelId        String            @map("label_id")
  createdAt      DateTime          @default(now()) @map("created_at")
  conversation   InboxConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  label          InboxLabel        @relation(fields: [labelId], references: [id], onDelete: Cascade)

  @@id([conversationId, labelId])
  @@map("inbox_conversation_labels")
}

model InboxConversationParticipant {
  conversationId String            @map("conversation_id")
  userId         String            @map("user_id")
  createdAt      DateTime          @default(now()) @map("created_at")
  conversation   InboxConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@id([conversationId, userId])
  @@map("inbox_conversation_participants")
}

model InboxMention {
  id          String       @id @default(uuid())
  messageId   String       @map("message_id")
  mentionedId String       @map("mentioned_id")
  read        Boolean      @default(false)
  createdAt   DateTime     @default(now()) @map("created_at")
  message     InboxMessage @relation(fields: [messageId], references: [id], onDelete: Cascade)

  @@index([mentionedId])
  @@map("inbox_mentions")
}

model InboxAgentSignature {
  id          String    @id @default(uuid())
  workspaceId String    @map("workspace_id")
  userId      String    @map("user_id")
  body        String
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, userId])
  @@map("inbox_agent_signatures")
}

model InboxDisplayIdSequence {
  workspaceId String @id @map("workspace_id")
  lastId      Int    @default(0) @map("last_id")

  @@map("inbox_display_id_sequences")
}


model WorkspaceMember {
  workspaceId String    @map("workspace_id")
  userId      String    @map("user_id")
  role        String    @default("member")
  createdAt   DateTime  @default(now()) @map("created_at")
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@id([workspaceId, userId])
  @@map("workspace_members")
}

model User {
  id                 String                   @id @default(uuid())
  clerkId            String                   @unique @map("clerk_id")
  createdAt          DateTime                 @default(now()) @map("created_at")
  updatedAt          DateTime                 @updatedAt @map("updated_at")
  onboardingProgress UserOnboardingProgress[]

  @@map("users")
}

model UserOnboardingProgress {
  id          String    @id @default(uuid())
  userId      String    @map("user_id")
  tourKey     String    @map("tour_key")
  status      String    @default("not_started") // not_started | in_progress | completed | skipped
  stepIndex   Int       @default(0) @map("step_index")
  completedAt DateTime? @map("completed_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, tourKey])
  @@map("user_onboarding_progress")
}

model Agent {
  id          String         @id @default(uuid())
  workspaceId String         @map("workspace_id")
  name        String
  type        String
  status      String         @default("draft")
  config      String
  createdAt   DateTime       @default(now()) @map("created_at")
  updatedAt   DateTime       @updatedAt @map("updated_at")
  workspace   Workspace      @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  runs        AgentRun[]
  messages    AgentMessage[]

  @@map("agents")
}

model AgentRun {
  id          String         @id @default(uuid())
  agentId     String         @map("agent_id")
  status      String
  startedAt   DateTime       @default(now()) @map("started_at")
  completedAt DateTime?      @map("completed_at")
  triggerData String?        @map("trigger_data")
  agent       Agent          @relation(fields: [agentId], references: [id], onDelete: Cascade)
  steps       AgentRunStep[]

  @@map("agent_runs")
}

model AgentRunStep {
  id        String   @id @default(uuid())
  runId     String   @map("run_id")
  nodeId    String   @map("node_id")
  status    String
  output    String?
  error     String?
  startedAt DateTime @default(now()) @map("started_at")
  duration  Int?
  run       AgentRun @relation(fields: [runId], references: [id], onDelete: Cascade)

  @@map("agent_run_steps")
}

model AgentMessage {
  id        String   @id @default(uuid())
  agentId   String?  @map("agent_id")
  userId    String   @map("user_id")
  role      String
  content   String
  createdAt DateTime @default(now()) @map("created_at")
  agent     Agent?   @relation(fields: [agentId], references: [id], onDelete: SetNull)

  @@map("agent_messages")
}

model Contact {
  id                    String            @id @default(uuid())
  workspaceId           String            @map("workspace_id")
  companyId             String?           @map("company_id")
  firstName             String            @map("first_name")
  lastName              String            @map("last_name")
  middleName            String?           @map("middle_name")
  suffix                String?
  avatarUrl             String?           @map("avatar_url")
  email                 String?
  emailsJson            String?           @map("emails_json")
  phone                 String?
  phonesJson            String?           @map("phones_json")
  location              String?
  title                 String?
  leadScore             Int               @default(0) @map("lead_score")
  healthScore           Int               @default(0) @map("health_score")
  ownerId               String?           @map("owner_id")
  dndEnabled            Boolean           @default(false) @map("dnd_enabled")
  preferredChannel      String            @default("email") @map("preferred_channel")
  about                 String?
  tagsJson              String            @default("[]") @map("tags_json")
  source                String?
  status                String?
  color                 String            @default("#7dd3fc")
  assignedUserId        String?           @map("assigned_user_id")
  customFieldsJson      String?           @map("custom_fields_json")
  lastContactedAt       DateTime?         @map("last_contacted_at")
  dateOfBirth           DateTime?         @map("date_of_birth")
  preferredName         String?           @map("preferred_name")
  socialProfilesJson    String?           @map("social_profiles_json")
  addressesJson         String?           @map("addresses_json")
  engagementScore       Int               @default(0) @map("engagement_score")
  contactType           String?           @map("contact_type")
  reportingManagerId    String?           @map("reporting_manager_id")
  teamId                String?           @map("team_id")
  createdAt             DateTime          @default(now()) @map("created_at")
  updatedAt             DateTime          @updatedAt @map("updated_at")
  workspace             Workspace         @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  company               Company?          @relation(fields: [companyId], references: [id], onDelete: SetNull)
  deals                 Deal[]
  tasks                 Task[]
  appointments          Appointment[]
  conversations         Conversation[]
  events                ContactEvent[]
  smartListItems        SmartListItem[]
  relationshipsAsSource ContactRelation[] @relation("source_contact")
  relationshipsAsTarget ContactRelation[] @relation("target_contact")
  // Ad attribution — source field holds 'GOOGLE_ADS' | 'FACEBOOK_ADS' when applicable
  adLeadId              String?           @unique @map("ad_lead_id")
  adLead                AdLead?           @relation("ContactAdLead", fields: [adLeadId], references: [id], onDelete: SetNull)

  // Email Marketing engagement fields & relations
  lastEmailOpenedAt     DateTime?         @map("last_email_opened_at")
  lastEmailClickedAt    DateTime?         @map("last_email_clicked_at")
  totalEmailsReceived   Int               @default(0) @map("total_emails_received")
  totalOpens            Int               @default(0) @map("total_opens")
  listMemberships       ContactListMembership[]
  campaignRecipients    CampaignRecipient[]
  automationEnrollments AutomationEnrollment[]
  emailEvents           EmailEvent[]

  @@index([workspaceId])
  @@index([email])
  @@map("contacts")
}

model Company {
  id               String     @id @default(uuid())
  workspaceId      String     @map("workspace_id")
  name             String
  logoUrl          String?    @map("logo_url")
  website          String?
  industry         String?
  location         String?
  employees        String?
  revenue          String?
  description      String?
  createdAt        DateTime   @default(now()) @map("created_at")
  updatedAt        DateTime   @updatedAt @map("updated_at")
  customFieldsJson String?    @map("custom_fields_json")
  workspace        Workspace  @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  contacts         Contact[]
  deals            Deal[]
  tasks            Task[]
  activities       Activity[]

  @@map("companies")
}

model Deal {
  id                  String         @id @default(uuid())
  workspaceId         String         @map("workspace_id")
  companyId           String?        @map("company_id")
  contactId           String?        @map("contact_id")
  pipelineStageId     String?        @map("pipeline_stage_id")
  title               String
  amount              Float          @default(0)
  probability         Int            @default(0)
  priority            String         @default("medium")
  closeDate           DateTime?      @map("close_date")
  ownerId             String?        @map("owner_id")
  description         String?
  wonLostReason       String?        @map("won_lost_reason")
  daysInStage         Int            @default(0) @map("days_in_stage")
  lastActivity        DateTime?      @map("last_activity")
  currency            String         @default("USD")
  dealType            String?        @map("deal_type")
  competitor          String?
  probabilityOverride Int?           @map("probability_override")
  createdAt           DateTime       @default(now()) @map("created_at")
  updatedAt           DateTime       @updatedAt @map("updated_at")
  workspace           Workspace      @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  company             Company?       @relation(fields: [companyId], references: [id], onDelete: SetNull)
  customFieldsJson    String?                  @map("custom_fields_json")
  tagsJson            String?                  @default("[]") @map("tags_json")
  source              String?
  status              String                   @default("open")
  wonLostNotes        String?                  @map("won_lost_notes")
  contact             Contact?                 @relation(fields: [contactId], references: [id], onDelete: SetNull)
  pipelineStage       PipelineStage?           @relation(fields: [pipelineStageId], references: [id], onDelete: SetNull)
  activities          Activity[]
  tasks               Task[]
  lineItems           OpportunityLineItem[]
  opportunityLogs     OpportunityActivityLog[]

  @@index([workspaceId])
  @@index([pipelineStageId])
  @@map("deals")
}

model Task {
  id          String    @id @default(uuid())
  workspaceId String    @map("workspace_id")
  contactId   String?   @map("contact_id")
  companyId   String?   @map("company_id")
  dealId      String?   @map("deal_id")
  title       String
  description String?
  type        String    @default("follow_up")
  dueDate     DateTime? @map("due_date")
  priority    String    @default("medium")
  status      String    @default("pending")
  assigneeId  String?   @map("assignee_id")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  contact     Contact?  @relation(fields: [contactId], references: [id], onDelete: Cascade)
  company     Company?  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  deal        Deal?     @relation(fields: [dealId], references: [id], onDelete: Cascade)

  @@map("tasks")
}

model Activity {
  id          String   @id @default(uuid())
  workspaceId String?  @map("workspace_id")
  dealId      String?  @map("deal_id")
  contactId   String?  @map("contact_id")
  companyId   String?  @map("company_id")
  type        String
  title       String
  notes       String?
  duration    Int?
  outcome     String?
  createdAt   DateTime @default(now()) @map("created_at")
  deal        Deal?    @relation(fields: [dealId], references: [id], onDelete: Cascade)
  company     Company? @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@map("activities")
}

model ApiKey {
  id           String    @id @default(uuid())
  workspaceId  String    @map("workspace_id")
  provider     String
  keyEncrypted String    @map("key_encrypted")
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")
  workspace    Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, provider])
  @@map("api_keys")
}

model Integration {
  id           String    @id @default(uuid())
  workspaceId  String    @map("workspace_id")
  provider     String // e.g. facebook, instagram, linkedin, tiktok
  accessToken  String    @map("access_token")
  refreshToken String?   @map("refresh_token")
  scopes       String?
  expiresAt    DateTime? @map("expires_at")
  accountId    String?   @map("account_id") // Provider's account identifier
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")
  workspace    Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, provider])
  @@map("integrations")
}

model ChannelConnection {
  id                        String    @id @default(uuid())
  workspaceId               String    @map("workspace_id")
  userId                    String    @map("user_id")
  provider                  String // "gmail" | "outlook" | "twilio"
  label                     String? // e.g. "Work Gmail" — display name
  email                     String? // connected email address (for display only)
  credentialsJson           String    @map("credentials_json") // AES-256-GCM encrypted JSON
  isActive                  Boolean   @default(true) @map("is_active")
  // Twilio-specific
  twilioPhoneNumber         String?   @map("twilio_phone_number")
  // Outlook-specific (Microsoft push subscriptions expire every 3 days)
  outlookSubscriptionId     String?   @map("outlook_subscription_id")
  outlookSubscriptionExpiry DateTime? @map("outlook_subscription_expiry")
  // Gmail-specific (tracks polling state)
  gmailHistoryId            String?   @map("gmail_history_id")
  lastPolledAt              DateTime? @map("last_polled_at")
  createdAt                 DateTime  @default(now()) @map("created_at")
  updatedAt                 DateTime  @updatedAt @map("updated_at")
  workspace                 Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, userId, provider])
  @@index([workspaceId])
  @@map("channel_connections")
}

model Appointment {
  id          String    @id @default(uuid())
  workspaceId String    @map("workspace_id")
  title       String
  description String?
  type        String    @default("meeting")
  location    String?
  contactId   String?   @map("contact_id")
  startTime   DateTime  @map("start_time")
  endTime     DateTime  @map("end_time")
  status      String    @default("scheduled")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  contact     Contact?  @relation(fields: [contactId], references: [id], onDelete: SetNull)

  @@map("appointments")
}

model Conversation {
  id                  String                @id @default(uuid())
  workspaceId         String                @map("workspace_id")
  contactId           String?               @map("contact_id")
  channel             String                @default("sms")
  status              String                @default("open")
  unreadCount         Int                   @default(0) @map("unread_count")
  subject             String? // email subject line
  externalId          String?               @map("external_id") // threadId from provider (Gmail, Outlook, PSID for Meta)
  channelConnectionId String?               @map("channel_connection_id")
  lastMessageAt       DateTime?             @map("last_message_at")
  assignedUserId      String?               @map("assigned_user_id")
  starred             Boolean               @default(false)
  createdAt           DateTime              @default(now()) @map("created_at")
  updatedAt           DateTime              @updatedAt @map("updated_at")
  workspace           Workspace             @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  contact             Contact?              @relation(fields: [contactId], references: [id], onDelete: SetNull)
  messages            ConversationMessage[]

  @@map("conversations")
}

model ConversationMessage {
  id             String       @id @default(uuid())
  conversationId String       @map("conversation_id")
  sender         String
  body           String
  direction      String       @default("outbound")
  externalId     String?      @map("external_id") // message ID from provider (for deduplication)
  status         String       @default("sent") // "sent" | "delivered" | "read" | "failed"
  channel        String? // per-message channel override (matches conversation channel by default)
  errorMsg       String?      @map("error_msg")
  attachments    String?
  createdAt      DateTime     @default(now()) @map("created_at")
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@map("conversation_messages")
}

model ContactEvent {
  id           String   @id @default(uuid())
  contactId    String   @map("contact_id")
  type         String
  title        String
  content      String?
  metadataJson String?  @map("metadata_json")
  createdAt    DateTime @default(now()) @map("created_at")
  contact      Contact  @relation(fields: [contactId], references: [id], onDelete: Cascade)

  @@map("contact_events")
}

model Pipeline {
  id                 String                 @id @default(uuid())
  workspaceId        String                 @map("workspace_id")
  name               String
  isDefault          Boolean                @default(false) @map("is_default")
  staleThresholdDays Int                    @default(14) @map("stale_threshold_days")
  allowStageSkip     Boolean                @default(true) @map("allow_stage_skip")
  enableLineItems    Boolean                @default(false) @map("enable_line_items")
  visibleTabsJson    String?                @default("[\"overview\",\"activity\",\"line_items\",\"files\",\"automations\"]") @map("visible_tabs_json")
  createdAt          DateTime               @default(now()) @map("created_at")
  updatedAt          DateTime               @updatedAt @map("updated_at")
  workspace          Workspace              @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  stages             PipelineStage[]
  wonLostReasons     WonLostReason[]
  savedViews         OpportunitySavedView[]

  @@map("pipelines")
}

model PipelineStage {
  id                 String   @id @default(uuid())
  pipelineId         String   @map("pipeline_id")
  name               String
  color              String   @default("#52677D")
  order              Int      @default(0)
  probability        Int      @default(0)
  isWon              Boolean  @default(false) @map("is_won")
  isLost             Boolean  @default(false) @map("is_lost")
  requiredFieldsJson String?  @default("[]") @map("required_fields_json")
  createdAt          DateTime @default(now()) @map("created_at")
  updatedAt          DateTime @updatedAt @map("updated_at")
  pipeline           Pipeline @relation(fields: [pipelineId], references: [id], onDelete: Cascade)
  deals              Deal[]

  @@map("pipeline_stages")
}

model SmartList {
  id          String          @id @default(uuid())
  workspaceId String          @map("workspace_id")
  name        String
  description String?         @default("")
  filtersJson String          @default("[]") @map("filters_json")
  matchMode   String          @default("all") @map("match_mode")
  viewMode    String          @default("table") @map("view_mode")
  columnsJson String          @default("[]") @map("columns_json")
  author      String?
  createdAt   DateTime        @default(now()) @map("created_at")
  updatedAt   DateTime        @updatedAt @map("updated_at")
  workspace   Workspace       @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  items       SmartListItem[]

  @@map("smart_lists")
}

model SmartListItem {
  id          String    @id @default(uuid())
  smartListId String    @map("smart_list_id")
  contactId   String    @map("contact_id")
  addedAt     DateTime  @default(now()) @map("added_at")
  smartList   SmartList @relation(fields: [smartListId], references: [id], onDelete: Cascade)
  contact     Contact   @relation(fields: [contactId], references: [id], onDelete: Cascade)

  @@unique([smartListId, contactId])
  @@map("smart_list_items")
}

model Notification {
  id          String    @id @default(uuid())
  workspaceId String    @map("workspace_id")
  title       String
  body        String?
  type        String    @default("info")
  read        Boolean   @default(false)
  link        String?
  createdAt   DateTime  @default(now()) @map("created_at")
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@map("notifications")
}

model CustomField {
  id          String    @id @default(uuid())
  workspaceId String    @map("workspace_id")
  entityType  String    @map("entity_type") // "contact" | "company" | "deal"
  label       String
  type        String // "text" | "number" | "date" | "select" | "boolean"
  optionsJson String?   @map("options_json")
  required    Boolean   @default(false)
  order       Int       @default(0)
  pipelineId  String?   @map("pipeline_id")
  scope       String    @default("all") // "all" | "pipeline"
  createdAt   DateTime  @default(now()) @map("created_at")
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@map("custom_fields")
}

model Tag {
  id          String    @id @default(uuid())
  workspaceId String    @map("workspace_id")
  name        String
  color       String    @default("#52677D")
  isShared    Boolean   @default(true) @map("is_shared")
  entityType  String    @default("all") @map("entity_type") // "all" | "contacts" | "opportunities"
  createdAt   DateTime  @default(now()) @map("created_at")
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, name])
  @@map("tags")
}

model WonLostReason {
  id          String    @id @default(uuid())
  workspaceId String    @map("workspace_id")
  pipelineId  String?   @map("pipeline_id")
  reason      String
  type        String    @default("both") // "won" | "lost" | "both"
  createdAt   DateTime  @default(now()) @map("created_at")
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  pipeline    Pipeline? @relation(fields: [pipelineId], references: [id], onDelete: Cascade)

  @@map("won_lost_reasons")
}

model OpportunityLineItem {
  id          String   @id @default(uuid())
  dealId      String   @map("deal_id")
  name        String
  description String?
  quantity    Float    @default(1)
  unitPrice   Float    @default(0) @map("unit_price")
  subtotal    Float    @default(0)
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")
  deal        Deal     @relation(fields: [dealId], references: [id], onDelete: Cascade)

  @@index([dealId])
  @@map("opportunity_line_items")
}

model OpportunityActivityLog {
  id           String    @id @default(uuid())
  workspaceId  String    @map("workspace_id")
  dealId       String    @map("deal_id")
  type         String    // "created" | "stage_change" | "field_edit" | "owner_reassigned" | "tags_changed" | "won_lost" | "line_item" | "file"
  title        String
  description  String?
  userId       String?   @map("user_id")
  userName     String?   @map("user_name")
  metadataJson String?   @map("metadata_json")
  createdAt    DateTime  @default(now()) @map("created_at")
  deal         Deal      @relation(fields: [dealId], references: [id], onDelete: Cascade)
  workspace    Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([workspaceId])
  @@index([dealId])
  @@map("opportunity_activity_logs")
}

model OpportunitySavedView {
  id             String    @id @default(uuid())
  workspaceId    String    @map("workspace_id")
  pipelineId     String?   @map("pipeline_id")
  name           String
  isDefault      Boolean   @default(false) @map("is_default")
  viewType       String    @default("board") @map("view_type") // "board" | "list" | "calendar"
  filtersJson    String    @default("[]") @map("filters_json")
  sortJson       String?   @map("sort_json")
  columnsJson    String?   @map("columns_json")
  cardConfigJson String?   @map("card_config_json")
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")
  workspace      Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  pipeline       Pipeline? @relation(fields: [pipelineId], references: [id], onDelete: Cascade)

  @@index([workspaceId])
  @@map("opportunity_saved_views")
}

model WebhookEndpoint {
  id          String    @id @default(uuid())
  workspaceId String    @map("workspace_id")
  agentId     String?   @map("agent_id")
  url         String
  secret      String
  events      String
  active      Boolean   @default(true)
  createdAt   DateTime  @default(now()) @map("created_at")
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@map("webhook_endpoints")
}

model ContactRelation {
  id               String   @id @default(uuid())
  sourceContactId  String   @map("source_contact_id")
  targetContactId  String   @map("target_contact_id")
  relationshipType String   @map("relationship_type")
  createdAt        DateTime @default(now()) @map("created_at")

  sourceContact Contact @relation("source_contact", fields: [sourceContactId], references: [id], onDelete: Cascade)
  targetContact Contact @relation("target_contact", fields: [targetContactId], references: [id], onDelete: Cascade)

  @@unique([sourceContactId, targetContactId, relationshipType])
  @@map("contact_relations")
}

model Attachment {
  id          String    @id @default(uuid())
  workspaceId String    @map("workspace_id")
  entityType  String    @map("entity_type") // contact, deal, company, task, activity
  entityId    String    @map("entity_id")
  fileName    String    @map("file_name")
  fileUrl     String    @map("file_url")
  fileSize    Int?      @map("file_size")
  fileType    String?   @map("file_type")
  createdAt   DateTime  @default(now()) @map("created_at")
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([entityType, entityId])
  @@map("attachments")
}

// ── Native Workflow Models ──────────────────────────────────────────────────
model Workflow {
  id            String    @id @default(uuid())
  workspaceId   String    @map("workspace_id")
  name          String
  description   String?
  status        String    @default("draft")
  triggerType   String?   @map("trigger_type")
  folderName    String?   @map("folder_name")
  tags          String    @default("[]")
  isFavorite    Boolean   @default(false) @map("is_favorite")
  folderId      String?   @map("folder_id")
  lastRunAt     DateTime? @map("last_run_at")
  lastRunStatus String?   @map("last_run_status")
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")

  // Native engine fields
  engineType      String  @default("native") @map("engine_type")
  definitionJson  String  @default("{}") @map("definition_json")
  variablesJson   String  @default("{}") @map("variables_json")
  settingsJson    String  @default("{}") @map("settings_json")
  errorWorkflowId String? @map("error_workflow_id")
  executionCount  Int     @default(0) @map("execution_count")
  successCount    Int     @default(0) @map("success_count")
  failureCount    Int     @default(0) @map("failure_count")

  workspace Workspace     @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  runs      WorkflowRun[]

  // Native engine relations
  nativeDefinition        NativeWorkflowDefinition?
  schedules               WorkflowSchedule[]
  webhooks                WorkflowWebhook[]
  crmTriggerSubscriptions CrmTriggerSubscription[]

  @@index([workspaceId])
  @@map("workflows")
}

model WorkflowRun {
  id           String    @id @default(uuid())
  workspaceId  String    @map("workspace_id")
  workflowId   String    @map("workflow_id")
  status       String
  durationMs   Int?      @map("duration_ms")
  stepCount    Int       @default(0) @map("step_count")
  triggerData  String?   @map("trigger_data")
  errorMessage String?   @map("error_message")
  startedAt    DateTime  @default(now()) @map("started_at")
  finishedAt   DateTime? @map("finished_at")

  // Native engine fields
  engineType    String    @default("native") @map("engine_type")
  runData       String    @default("{}") @map("run_data")
  waitingNodeId String?   @map("waiting_node_id")
  resumeAt      DateTime? @map("resume_at")

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  workflow  Workflow  @relation(fields: [workflowId], references: [id], onDelete: Cascade)

  @@index([workflowId])
  @@index([workspaceId])
  @@map("workflow_runs")
}

// ── Automation Module — Folders ──────────────────────────────────────────────

model AutomationFolder {
  id          String    @id @default(uuid())
  workspaceId String    @map("workspace_id")
  name        String
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([workspaceId])
  @@map("automation_folders")
}

// ── Automation Module — Tables ────────────────────────────────────────────────

model AutomationTable {
  id          String                  @id @default(uuid())
  workspaceId String                  @map("workspace_id")
  name        String
  createdAt   DateTime                @default(now()) @map("created_at")
  updatedAt   DateTime                @updatedAt @map("updated_at")
  workspace   Workspace               @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  fields      AutomationTableField[]
  records     AutomationTableRecord[]

  @@index([workspaceId])
  @@map("automation_tables")
}

model AutomationTableField {
  id        String          @id @default(uuid())
  tableId   String          @map("table_id")
  name      String
  type      String          @default("TEXT") // TEXT | NUMBER | DATE | STATIC_DROPDOWN
  options   String          @default("[]") // JSON: [{label,value}]
  order     Int             @default(0)
  createdAt DateTime        @default(now()) @map("created_at")
  table     AutomationTable @relation(fields: [tableId], references: [id], onDelete: Cascade)

  @@index([tableId])
  @@map("automation_table_fields")
}

model AutomationTableRecord {
  id        String          @id @default(uuid())
  tableId   String          @map("table_id")
  cells     String          @default("{}") // JSON: fieldId -> value
  createdAt DateTime        @default(now()) @map("created_at")
  updatedAt DateTime        @updatedAt @map("updated_at")
  table     AutomationTable @relation(fields: [tableId], references: [id], onDelete: Cascade)

  @@index([tableId])
  @@map("automation_table_records")
}

// ── Automation Module — Releases ──────────────────────────────────────────────

model Release {
  id          String    @id @default(uuid())
  workspaceId String    @map("workspace_id")
  name        String
  description String?
  status      String    @default("PUBLISHED") // PUBLISHED, ARCHIVED
  createdAt   DateTime  @default(now()) @map("created_at")
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([workspaceId])
  @@map("automation_releases")
}

// ── Native Workflow Engine Models ─────────────────────────────────────────────

model NativeWorkflowDefinition {
  id         String   @id @default(uuid())
  workflowId String   @unique @map("workflow_id")
  nodesJson  String   @default("[]") @map("nodes_json")
  edgesJson  String   @default("[]") @map("edges_json")
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")
  workflow   Workflow @relation(fields: [workflowId], references: [id], onDelete: Cascade)

  @@map("native_workflow_definitions")
}

model WorkflowCredential {
  id            String    @id @default(uuid())
  workspaceId   String    @map("workspace_id")
  name          String
  type          String // e.g. "smtp", "oauth2_google", "api_key_openai"
  dataEncrypted String    @map("data_encrypted") // AES-256 encrypted JSON
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")
  workspace     Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, name, type])
  @@map("workflow_credentials")
}

model WorkflowSchedule {
  id          String    @id @default(uuid())
  workspaceId String    @map("workspace_id")
  workflowId  String    @map("workflow_id")
  nodeId      String    @map("node_id")
  cronExpr    String    @map("cron_expr")
  timezone    String    @default("UTC")
  active      Boolean   @default(true)
  lastRunAt   DateTime? @map("last_run_at")
  nextRunAt   DateTime? @map("next_run_at")
  createdAt   DateTime  @default(now()) @map("created_at")
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  workflow    Workflow  @relation(fields: [workflowId], references: [id], onDelete: Cascade)

  @@index([workspaceId, active])
  @@index([nextRunAt, active])
  @@map("workflow_schedules")
}

model WorkflowWebhook {
  id          String    @id @default(uuid())
  workspaceId String    @map("workspace_id")
  workflowId  String    @map("workflow_id")
  nodeId      String    @map("node_id")
  path        String    @unique // e.g. "/hooks/abc123"
  method      String    @default("POST")
  secret      String?
  active      Boolean   @default(true)
  createdAt   DateTime  @default(now()) @map("created_at")
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  workflow    Workflow  @relation(fields: [workflowId], references: [id], onDelete: Cascade)

  @@index([path])
  @@index([workspaceId])
  @@map("workflow_webhooks")
}

model WorkflowTemplate {
  id             String   @id @default(uuid())
  name           String
  description    String?
  category       String
  tags           String   @default("[]")
  definitionJson String   @map("definition_json") // Full workflow definition JSON
  thumbnailUrl   String?  @map("thumbnail_url")
  usageCount     Int      @default(0) @map("usage_count")
  isSystem       Boolean  @default(true) @map("is_system") // false = user-created
  workspaceId    String?  @map("workspace_id") // null = global/system template
  createdAt      DateTime @default(now()) @map("created_at")

  @@index([category])
  @@map("workflow_templates")
}

model CrmTriggerSubscription {
  id          String    @id @default(uuid())
  workspaceId String    @map("workspace_id")
  workflowId  String    @map("workflow_id")
  nodeId      String    @map("node_id")
  entityType  String    @map("entity_type") // contact | deal | company | task
  eventType   String    @map("event_type") // created | updated | deleted | stage_changed | tag_added
  filtersJson String    @default("{}") @map("filters_json")
  active      Boolean   @default(true)
  createdAt   DateTime  @default(now()) @map("created_at")
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  workflow    Workflow  @relation(fields: [workflowId], references: [id], onDelete: Cascade)

  @@index([workspaceId, entityType, eventType, active])
  @@map("crm_trigger_subscriptions")
}

// ── Ad Manager ────────────────────────────────────────────────────────────────

enum AdPlatform {
  GOOGLE
  FACEBOOK
}

enum AdAccountStatus {
  ACTIVE
  NEEDS_ATTENTION
  DISCONNECTED
}

enum AdCampaignStatus {
  ACTIVE
  PAUSED
  DRAFT
  ENDED
  REJECTED
}

enum AdType {
  GOOGLE_SEARCH
  GOOGLE_DISPLAY
  FACEBOOK_FEED
  FACEBOOK_LEAD
}

enum BudgetType {
  DAILY
  LIFETIME
}

enum LeadSyncStatus {
  PENDING
  SYNCED
  FAILED
}

/// One ad account per platform per workspace.
/// accessToken and refreshToken are AES-256-GCM encrypted (encryptString).
model AdAccount {
  id                   String          @id @default(uuid())
  workspaceId          String          @map("workspace_id")
  platform             AdPlatform
  externalAccountId    String          @map("external_account_id")
  accountName          String          @map("account_name")
  accessToken          String          @map("access_token")
  refreshToken         String          @default("") @map("refresh_token")
  tokenExpiresAt       DateTime?       @map("token_expires_at")
  tokenLastRefreshedAt DateTime?       @map("token_last_refreshed_at")
  facebookPages        String          @default("[]") @map("facebook_pages") // JSON: [{id, name, accessToken}]
  status               AdAccountStatus @default(ACTIVE)
  connectedAt          DateTime        @default(now()) @map("connected_at")
  connectedByUserId    String          @map("connected_by_user_id")
  lastSyncAt           DateTime?       @map("last_sync_at")
  lastPollAt           DateTime?       @map("last_poll_at")
  disconnectedAt       DateTime?       @map("disconnected_at")
  createdAt            DateTime        @default(now()) @map("created_at")
  updatedAt            DateTime        @updatedAt @map("updated_at")

  workspace Workspace    @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  campaigns AdCampaign[]

  @@unique([workspaceId, platform])
  @@index([workspaceId])
  @@index([status])
  @@map("ad_accounts")
}

/// An ad campaign on Google or Facebook.
/// targeting: { locations, keywords?, ageMin?, ageMax?, genders?, interests? }
/// creative:  { headlines, descriptions, imageUrls, callToAction, finalUrl?, leadFormFields?, facebookPageId?, primaryText? }
model AdCampaign {
  id          String     @id @default(uuid())
  workspaceId String     @map("workspace_id")
  adAccountId String     @map("ad_account_id")
  platform    AdPlatform
  adType      AdType     @map("ad_type")

  platformCampaignId String? @map("platform_campaign_id")
  platformAdSetId    String? @map("platform_ad_set_id")
  platformAdGroupId  String? @map("platform_ad_group_id")
  platformAdId       String? @map("platform_ad_id")

  name            String
  objective       String
  status          AdCampaignStatus @default(DRAFT)
  rejectionReason String?          @map("rejection_reason")

  budgetType        BudgetType @map("budget_type")
  budgetAmountCents Int        @map("budget_amount_cents")

  scheduleType String    @map("schedule_type")
  startDate    DateTime? @map("start_date")
  endDate      DateTime? @map("end_date")

  bidStrategy    String? @map("bid_strategy")
  targetCpaCents Int?    @map("target_cpa_cents")

  targetingJson String @default("{}") @map("targeting_json")
  creativeJson  String @default("{}") @map("creative_json")

  cachedSpend30dCents Int       @default(0) @map("cached_spend_30d_cents")
  cachedLeads30d      Int       @default(0) @map("cached_leads_30d")
  cachedCtr30d        Float     @default(0) @map("cached_ctr_30d")
  metricsCachedAt     DateTime? @map("metrics_cached_at")

  createdByUserId    String    @map("created_by_user_id")
  lastEditedByUserId String    @map("last_edited_by_user_id")
  launchedAt         DateTime? @map("launched_at")
  createdAt          DateTime  @default(now()) @map("created_at")
  updatedAt          DateTime  @updatedAt @map("updated_at")

  workspace Workspace          @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  adAccount AdAccount          @relation(fields: [adAccountId], references: [id])
  metrics   AdMetricSnapshot[]
  leads     AdLead[]

  @@index([workspaceId])
  @@index([adAccountId])
  @@index([status])
  @@index([platform])
  @@index([workspaceId, status])
  @@map("ad_campaigns")
}

/// Daily metric snapshot per campaign. date is stored as DateTime (SQLite compatible).
model AdMetricSnapshot {
  id               String   @id @default(uuid())
  campaignId       String   @map("campaign_id")
  date             DateTime
  spendCents       Int      @default(0) @map("spend_cents")
  impressions      Int      @default(0)
  clicks           Int      @default(0)
  leads            Int      @default(0)
  ctr              Float    @default(0)
  costPerLeadCents Int?     @map("cost_per_lead_cents")
  syncedAt         DateTime @default(now()) @map("synced_at")

  campaign AdCampaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)

  @@unique([campaignId, date])
  @@index([campaignId])
  @@index([date])
  @@map("ad_metric_snapshots")
}

/// A lead captured from an ad platform.
/// rawData stores the raw platform payload as JSON string.
model AdLead {
  id             String     @id @default(uuid())
  workspaceId    String     @map("workspace_id")
  campaignId     String     @map("campaign_id")
  platform       AdPlatform
  platformLeadId String     @map("platform_lead_id")
  facebookFormId String?    @map("facebook_form_id")

  leadName    String? @map("lead_name")
  leadEmail   String? @map("lead_email")
  leadPhone   String? @map("lead_phone")
  rawDataJson String  @default("{}") @map("raw_data_json")

  syncStatus   LeadSyncStatus @default(PENDING) @map("sync_status")
  syncError    String?        @map("sync_error")
  syncAttempts Int            @default(0) @map("sync_attempts")
  syncedAt     DateTime?      @map("synced_at")

  capturedAt DateTime @map("captured_at")
  createdAt  DateTime @default(now()) @map("created_at")

  workspace Workspace  @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  campaign  AdCampaign @relation(fields: [campaignId], references: [id])
  // Reverse side of Contact.adLead (1-to-1, Contact owns the FK)
  contact   Contact?   @relation("ContactAdLead")

  @@unique([platform, platformLeadId])
  @@index([workspaceId])
  @@index([campaignId])
  @@index([syncStatus])
  @@index([capturedAt])
  @@map("ad_leads")
}

/// Workspace-level ad settings. Created on first access if missing.
model AdWorkspaceSettings {
  id                        String   @id @default(uuid())
  workspaceId               String   @unique @map("workspace_id")
  defaultDailyBudgetCents   Int?     @map("default_daily_budget_cents")
  leadNotificationsEnabled  Boolean  @default(true) @map("lead_notifications_enabled")
  leadNotificationMode      String   @default("IN_APP") @map("lead_notification_mode")
  aiAssistedCreativeDefault Boolean  @default(true) @map("ai_assisted_creative_default")
  createdAt                 DateTime @default(now()) @map("created_at")
  updatedAt                 DateTime @updatedAt @map("updated_at")

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@map("ad_workspace_settings")
}

/// Temporary OAuth state storage for Ads OAuth flows (Google + Facebook).
/// Records expire after 10 minutes and are deleted after use.
model AdsOAuthState {
  id          String   @id @default(uuid())
  state       String   @unique
  workspaceId String   @map("workspace_id")
  userId      String   @map("user_id")
  expiresAt   DateTime @map("expires_at")
  createdAt   DateTime @default(now()) @map("created_at")

  @@index([state])
  @@index([expiresAt])
  @@map("ads_oauth_states")
}

