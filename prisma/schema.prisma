enum SubscriptionStatus {
  SUBSCRIBED
  UNSUBSCRIBED
  BOUNCED
  COMPLAINED
  PENDING_CONFIRMATION
}

enum CampaignStatus {
  DRAFT
  SCHEDULED
  SENDING
  SENT
  PAUSED
  CANCELLED
}

enum AutomationStatus {
  DRAFT
  ACTIVE
  PAUSED
  ARCHIVED
}

enum AutomationTriggerType {
  CONTACT_CREATED
  TAG_ADDED
  TAG_REMOVED
  FORM_SUBMITTED
  LIST_JOINED
  DEAL_STAGE_CHANGED
  CUSTOM_FIELD_CHANGED
  DATE_BASED
  EMAIL_OPENED
  EMAIL_LINK_CLICKED
  MANUAL_ENROLLMENT
  API_EVENT
}

enum AutomationStepType {
  SEND_EMAIL
  WAIT
  CONDITION_BRANCH
  ADD_TAG
  REMOVE_TAG
  UPDATE_FIELD
  ADD_TO_LIST
  REMOVE_FROM_LIST
  WEBHOOK_CALL
  GOAL_CHECK
  EXIT_AUTOMATION
}

enum EnrollmentExitReason {
  COMPLETED_ALL_STEPS
  GOAL_MET
  MANUALLY_REMOVED
  UNSUBSCRIBED
  SUPPRESSED
  CONTACT_DELETED
}

enum EmailEventType {
  SENT
  DELIVERED
  DELIVERY_DELAYED
  OPENED
  CLICKED
  BOUNCED
  COMPLAINED
  UNSUBSCRIBED
}

enum ConsentSource {
  MANUAL_ADD
  CSV_IMPORT
  FORM_SUBMISSION
  API
  AUTOMATION
}

model EmailList {
  id             String                  @id @default(uuid())
  workspaceId    String                  @map("workspace_id")
  name           String
  doubleOptIn    Boolean                 @default(false) @map("double_opt_in")
  createdAt      DateTime                @default(now()) @map("created_at")
  updatedAt      DateTime                @updatedAt @map("updated_at")
  workspace      Workspace               @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  memberships    ContactListMembership[]

  @@index([workspaceId])
  @@map("email_lists")
}

model ContactListMembership {
  id               String             @id @default(uuid())
  workspaceId      String             @map("workspace_id")
  contactId        String             @map("contact_id")
  listId           String             @map("list_id")
  status           SubscriptionStatus @default(SUBSCRIBED)
  consentSource    ConsentSource      @map("consent_source")
  consentTimestamp DateTime           @default(now()) @map("consent_timestamp")
  workspace        Workspace          @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  contact          Contact            @relation(fields: [contactId], references: [id], onDelete: Cascade)
  list             EmailList          @relation(fields: [listId], references: [id], onDelete: Cascade)

  @@unique([contactId, listId])
  @@index([workspaceId])
  @@map("contact_list_memberships")
}

model Segment {
  id               String    @id @default(uuid())
  workspaceId      String    @map("workspace_id")
  name             String
  filterDefinition Json      @map("filter_definition")
  createdAt        DateTime  @default(now()) @map("created_at")
  updatedAt        DateTime  @updatedAt @map("updated_at")
  workspace        Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([workspaceId])
  @@map("email_segments")
}

model EmailTemplate {
  id             String    @id @default(uuid())
  workspaceId    String    @map("workspace_id")
  name           String
  blockJson      Json      @map("block_json")
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")
  workspace      Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([workspaceId])
  @@map("email_templates")
}

model Campaign {
  id             String              @id @default(uuid())
  workspaceId    String              @map("workspace_id")
