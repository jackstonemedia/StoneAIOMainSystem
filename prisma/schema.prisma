  AUTOPILOT
}

enum SdrStatus {
  ACTIVE
  PAUSED
  DRAFT
}

enum DossierStatus {
  DRAFTED
  APPROVED
  SENDING
  ENGAGED
  MEETING_BOOKED
  BOUNCED
  DECLINED
}

model AutonomousSdrAgent {
