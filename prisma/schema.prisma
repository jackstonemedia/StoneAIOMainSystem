  status              AutomationStatus      @default(DRAFT)
  triggerType         AutomationTriggerType @map("trigger_type")
  triggerConfig       Json                  @map("trigger_config")
  canvasJson          Json                  @map("canvas_json")
  reentryAllowed      Boolean               @default(false) @map("reentry_allowed")
  reentryCooldownDays Int                   @default(0) @map("reentry_cooldown_days")
  createdAt           DateTime              @default(now()) @map("created_at")
  updatedAt           DateTime              @updatedAt @map("updated_at")
  workspace           Workspace             @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  enrollments         AutomationEnrollment[]

  @@index([workspaceId])
  @@map("email_automations")
}

model AutomationEnrollment {
  id            String                @id @default(uuid())
  workspaceId   String                @map("workspace_id")
  automationId  String                @map("automation_id")
  contactId     String                @map("contact_id")
  currentStepId String?               @map("current_step_id")
  enrolledAt    DateTime              @default(now()) @map("enrolled_at")
  exitedAt      DateTime?             @map("exited_at")
  exitReason    EnrollmentExitReason? @map("exit_reason")
  workspace     Workspace             @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  automation    Automation            @relation(fields: [automationId], references: [id], onDelete: Cascade)
  contact       Contact               @relation(fields: [contactId], references: [id], onDelete: Cascade)

  @@index([workspaceId])
  @@index([automationId])
  @@index([contactId])
  @@map("automation_enrollments")
}

model EmailEvent {
  id                     String         @id @default(uuid())
  workspaceId            String         @map("workspace_id")
  contactId              String         @map("contact_id")
  campaignId             String?        @map("campaign_id")
  automationEnrollmentId String?        @map("automation_enrollment_id")
  eventType              EmailEventType @map("event_type")
  linkUrl                String?        @map("link_url")
  occurredAt             DateTime       @default(now()) @map("occurred_at")
  workspace              Workspace      @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
