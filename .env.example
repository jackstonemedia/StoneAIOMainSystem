# ─── App ──────────────────────────────────────────────────────────────────────
PORT=3000
NODE_ENV=development

# APP_URL: The URL where this app is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
VITE_APP_URL="http://localhost:3000"

# ─── Auth (Clerk) ─────────────────────────────────────────────────────────────
# Get these from https://dashboard.clerk.com → Your App → API Keys
VITE_CLERK_PUBLISHABLE_KEY=""
CLERK_SECRET_KEY=""
# Set to "true" only when you intentionally want to bypass Clerk locally.
VITE_DEV_AUTH_BYPASS="false"

# ─── Database ─────────────────────────────────────────────────────────────────
# SQLite (local dev — default if DATABASE_URL is not set):
# Leave empty to use file:./prisma/dev.db
#
# PostgreSQL (production — use Neon: https://neon.tech or Supabase: https://supabase.com):
# DATABASE_URL="postgresql://user:password@host:5432/dbname?sslmode=require"
DATABASE_URL=""

# ─── AI ───────────────────────────────────────────────────────────────────────
# Gemini API key — server-side only. Never expose this to the frontend.
# Get from: https://aistudio.google.com/app/apikey
GOOGLE_AI_API_KEY=
# Gemini model ids (optional; the provider retires ids without notice, so
# these are env-configurable, never hardcoded in code):
# GEMINI_MODEL — default model (default: gemini-3.8-flash)
# GEMINI_INTERVIEW_MODEL — interview/drafting (default: GEMINI_MODEL)
# GEMINI_SUMMARY_MODEL — short summaries (default: GEMINI_MODEL)
#GEMINI_MODEL=gemini-3.8-flash""

# ─── Voice (Retell) ───────────────────────────────────────────────────────────
# Get from: https://app.retellai.com/settings
RETELL_API_KEY=""

# ─── Email (Gmail-only) ───────────────────────────────────────────────────────
# Sending is Gmail-only via the workspace Gmail OAuth connection (Settings → Channels).
# No provider API key exists. See TRACKING_SECRET below for click tracking.

# Create with AI — HMAC secret for signed click-tracking tokens (spec §20).
# Optional in dev (an ephemeral per-boot secret is used when unset); set it in
# production so tokens survive restarts.
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
TRACKING_SECRET=""

# ─── SMS (Twilio) ─────────────────────────────────────────────────────────────
TWILIO_ACCOUNT_SID=""
TWILIO_AUTH_TOKEN=""
TWILIO_PHONE_NUMBER=""

# ─── OAuth Integrations ───────────────────────────────────────────────────────
# Meta (Facebook / Instagram)
FACEBOOK_ADS_APP_ID=""              # Your Meta App ID
FACEBOOK_ADS_APP_SECRET=""          # Your Meta App Secret
FACEBOOK_ADS_WEBHOOK_VERIFY_TOKEN="" # Custom random string for webhooks
FACEBOOK_ADS_REDIRECT_URI=""        # OAuth Callback URI

# Google Ads
GOOGLE_ADS_CLIENT_ID=""              # Google Cloud OAuth Client ID
GOOGLE_ADS_CLIENT_SECRET=""          # Google Cloud OAuth Client Secret
GOOGLE_ADS_DEVELOPER_TOKEN=""        # Google Ads API Developer Token
GOOGLE_ADS_REDIRECT_URI=""           # e.g. http://localhost:3000/api/ads/oauth/google/callback

# TikTok
TIKTOK_CLIENT_KEY=""
TIKTOK_CLIENT_SECRET=""

# LinkedIn
LINKEDIN_CLIENT_ID=""
LINKEDIN_CLIENT_SECRET=""

# Gmail OAuth
GMAIL_CLIENT_ID=""
GMAIL_CLIENT_SECRET=""
GMAIL_REDIRECT_URI=""

# Outlook / Microsoft OAuth
OUTLOOK_CLIENT_ID=""
OUTLOOK_CLIENT_SECRET=""
OUTLOOK_REDIRECT_URI=""

# Channel token encryption (required for Gmail/Outlook)
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
CHANNEL_ENCRYPTION_KEY=""

# Redis — real-time SSE push (optional; falls back to 15s polling without it)
REDIS_URL=""

