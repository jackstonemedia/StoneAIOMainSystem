  try {
    const { nodes, edges } = req.body as { nodes: any[]; edges: any[] };
    const workflowId = req.params.id;
    const workspaceId = req.workspaceId!;

    // 1. Save definition
    await db.nativeWorkflowDefinition.upsert({
      where: { workflowId },
      update: { nodesJson: JSON.stringify(nodes), edgesJson: JSON.stringify(edges) },
      create: { workflowId, nodesJson: JSON.stringify(nodes), edgesJson: JSON.stringify(edges) },
    });

    // 2. Find the trigger node (first node whose type starts with 'trigger.')
    const triggerNode = nodes.find((n: any) => n.type?.startsWith('trigger.'));

    // 3. Delete old subscriptions/schedules for this workflow ONLY
    //    For webhooks: read existing path BEFORE deleting so we can preserve it
    const existingWebhook = await db.workflowWebhook.findFirst({ where: { workflowId } });
    await db.crmTriggerSubscription.deleteMany({ where: { workflowId } });
    await db.workflowSchedule.deleteMany({ where: { workflowId } });
    await db.workflowWebhook.deleteMany({ where: { workflowId } });

    // 4. Create new subscription based on trigger type
    if (triggerNode) {
      const cfg = triggerNode.data?.config ?? triggerNode.config ?? {};

      if (triggerNode.type === 'trigger.crm_event') {
        const eventStr = (cfg.event as string) || 'contact.created';
        const [entityType, eventType] = eventStr.split('.');
        await db.crmTriggerSubscription.create({
          data: {
            workspaceId,
            workflowId,
            nodeId: triggerNode.id,
            entityType: entityType ?? 'contact',
            eventType: eventType ?? 'created',
            filtersJson: JSON.stringify(cfg.filters ?? {}),
            active: true,
          },
        });

      } else if (triggerNode.type === 'trigger.schedule') {
        const cronExpr = (cfg.cronExpression as string) || '0 9 * * 1';
        const timezone = (cfg.timezone as string) || 'UTC';
        await db.workflowSchedule.create({
          data: {
            workspaceId,
            workflowId,
            nodeId: triggerNode.id,
            cronExpr,
            timezone,
            active: true,
          },
        });

      } else if (triggerNode.type === 'trigger.webhook') {
        // Preserve path if this workflow previously had a webhook (avoids URL changes on save)
        const { nanoid } = await import('nanoid');
        const path = existingWebhook?.path ?? `/hooks/${nanoid(16)}`;
        const method = (cfg.method as string) || 'POST';
        const secret = (cfg.secret as string) || null;
        await db.workflowWebhook.create({
          data: {
            workspaceId,
            workflowId,
            nodeId: triggerNode.id,
            path,
            method,
            secret,
            active: true,
          },
        });
        // Reload webhook into in-memory registry
        const { webhookRegistry } = await import('../services/workflow-engine/webhook-registry.js');
        await webhookRegistry.reload();
      }
    }

    res.json({ success: true });
  } catch (e: any) {
    res.status(500).json({ error: e.message });
  }
});
