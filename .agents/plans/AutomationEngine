### Template install query (transaction)

```typescript
// Location: inline in api/routes/workflows.routes.ts POST /templates/:id/install handler
async function installTemplate(templateId: string, workspaceId: string, name?: string) {
  // 1. Fetch template with definition
  const template = await db.workflowTemplate.findFirst({
    where: {
      id: templateId,
      OR: [{ isSystem: true, workspaceId: null }, { workspaceId }],
    },
  });
  if (!template) throw new Error('Template not found or access denied');

  const def = JSON.parse(template.definitionJson) as { nodes: any[]; edges: any[] };

  // 2. Create workflow + definition in a transaction
  const workflow = await db.$transaction(async (tx) => {
    const wf = await tx.workflow.create({
      data: {
        workspaceId,
        name: name ?? template.name,
        description: template.description,
        engineType: 'native',
        status: 'draft',
      },
    });
    await tx.nativeWorkflowDefinition.create({
      data: {
        workflowId: wf.id,
        nodesJson: JSON.stringify(def.nodes),
        edgesJson: JSON.stringify(def.edges),
      },
    });
    return wf;
  });

  // 3. Increment usage count (non-critical, fire-and-forget)
  db.workflowTemplate.update({
    where: { id: templateId },
    data: { usageCount: { increment: 1 } },
  }).catch(() => {});

  return workflow;
}
```

