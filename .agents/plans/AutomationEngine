router.post('/:id/pause-native', async (req, res) => {
  try {
    const workflowId = req.params.id;
    const workspaceId = req.workspaceId!;

    // 1. Verify workspace ownership
    await db.workflow.findFirstOrThrow({ where: { id: workflowId, workspaceId } });

