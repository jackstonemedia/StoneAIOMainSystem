  const [campaign, setCampaign] = useState<Omit<EmailCampaign, 'id' | 'createdAt' | 'updatedAt'>>(() => {
    const empty = createEmptyCampaign()
    // Pre-fill from name/email from business settings
    return {
      ...empty,
