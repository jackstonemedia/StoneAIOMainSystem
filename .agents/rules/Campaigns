import { useRef, useState } from 'react'
import { EmailBlock, EmailCampaign } from '../../types/emailCampaign'
import { createBlock } from '../../lib/emailCampaignUtils'
import { BlockWrapper } from './BlockWrapper'

interface Props {
  blocks: EmailBlock[]
  emailStyles: EmailCampaign['emailStyles']
  selectedBlockId: string | null
  previewWidth: number
  onSelectBlock: (id: string) => void
  onBlocksChange: (blocks: EmailBlock[]) => void
  onUpdateBlockContent: (id: string, content: Partial<any>) => void
  onDeleteBlock: (id: string) => void
  onInsertBlock: (block: EmailBlock, atIndex: number) => void
  onMoveBlock: (from: number, to: number) => void
}

export function EmailCanvas({
  blocks, emailStyles, selectedBlockId, previewWidth,
  onSelectBlock, onBlocksChange, onUpdateBlockContent,
  onDeleteBlock, onInsertBlock, onMoveBlock,
}: Props) {

  // ─── DRAG STATE ───────────────────────────────────────────────────────────
  // dropIndex: which position in the blocks array we are hovering over.
  // Used to render the blue "drop here" indicator line.
  const [dropIndex, setDropIndex] = useState<number | null>(null)
  const dragBlockIndex = useRef<number | null>(null) // index of block being dragged within canvas

  // ─── DROP ZONE CALCULATION ────────────────────────────────────────────────
  // Given a dragover event on the canvas, calculate which block index
  // the user is hovering between. We use the Y coordinate and compare
  // against each block element's bounding rect midpoint.

  function getDropIndex(e: React.DragEvent, containerEl: HTMLDivElement): number {
    const blockEls = Array.from(containerEl.querySelectorAll('[data-block-index]')) as HTMLElement[]
    const mouseY = e.clientY
    for (let i = 0; i < blockEls.length; i++) {
      const rect = blockEls[i].getBoundingClientRect()
      const midY = rect.top + rect.height / 2
      if (mouseY < midY) return i
    }
    return blockEls.length // dropped at end
  }

  const canvasRef = useRef<HTMLDivElement>(null)

  // ─── CANVAS DRAG OVER ─────────────────────────────────────────────────────
  function handleDragOver(e: React.DragEvent) {
    e.preventDefault()
    e.dataTransfer.dropEffect = 'copy'
    if (!canvasRef.current) return
    const idx = getDropIndex(e, canvasRef.current)
    setDropIndex(idx)
  }

  function handleDragLeave() {
    setDropIndex(null)
  }

  // ─── CANVAS DROP ──────────────────────────────────────────────────────────
  // Two cases:
  // 1. source=palette — creating a new block from the block type
  // 2. source=canvas — reordering an existing block

  function handleDrop(e: React.DragEvent) {
    e.preventDefault()
    const source = e.dataTransfer.getData('source')
    const targetIndex = dropIndex ?? blocks.length
    setDropIndex(null)

    if (source === 'palette') {
      const blockType = e.dataTransfer.getData('blockType') as EmailBlock['type']
      const newBlock = createBlock(blockType)
      onInsertBlock(newBlock, targetIndex)
      // Auto-select the newly added block
      setTimeout(() => onSelectBlock(newBlock.id), 0)

    } else if (source === 'canvas') {
      const fromIndex = dragBlockIndex.current
      if (fromIndex === null || fromIndex === targetIndex) return
      onMoveBlock(fromIndex, targetIndex)
      dragBlockIndex.current = null
    }
  }

  // ─── BLOCK DRAG (reorder from canvas) ────────────────────────────────────
  // Called by BlockWrapper when user grabs the drag handle of an existing block.
  function handleBlockDragStart(e: React.DragEvent, index: number) {
    dragBlockIndex.current = index
    e.dataTransfer.setData('source', 'canvas')
    e.dataTransfer.effectAllowed = 'move'
  }

  // ─── EMPTY CANVAS ────────────────────────────────────────────────────────
  // When there are no blocks, show a drop zone that covers the full area.
  const isEmpty = blocks.length === 0

  return (
    // Outer container centers the email preview and applies the email bg color
    <div
      className="mx-auto"
      style={{
        width: previewWidth,
        minHeight: 400,
        backgroundColor: emailStyles.backgroundColor,
        fontFamily: emailStyles.fontFamily,
        transition: 'width 0.2s ease',
      }}
    >
      <div
        ref={canvasRef}
        onDragOver={handleDragOver}
        onDragLeave={handleDragLeave}
        onDrop={handleDrop}
        style={{ backgroundColor: emailStyles.contentBackgroundColor, minHeight: 400 }}
      >
        {isEmpty ? (
          // Empty state — shown before any blocks are added
          <div className="h-64 flex flex-col items-center justify-center text-gray-400 border-2 border-dashed border-gray-300 m-4 rounded-lg">
            <p className="text-sm font-medium">Drag blocks here to build your email</p>
            <p className="text-xs mt-1">Start with a heading or text block</p>
          </div>
        ) : (
          blocks.map((block, index) => (
            <div key={block.id} data-block-index={index}>
              {/* Drop indicator line — shown above this block when hovering */}
              {dropIndex === index && (
                <div className="h-0.5 bg-blue-500 mx-4 my-0.5" />
              )}

              <BlockWrapper
                block={block}
                index={index}
                isSelected={block.id === selectedBlockId}
                onSelect={() => onSelectBlock(block.id)}
                onDelete={() => onDeleteBlock(block.id)}
                onDragStart={e => handleBlockDragStart(e, index)}
                onUpdateContent={content => onUpdateBlockContent(block.id, content)}
              />
            </div>
          ))
        )}

        {/* Drop indicator at end of list */}
        {dropIndex === blocks.length && (
          <div className="h-0.5 bg-blue-500 mx-4 my-0.5" />
        )}
      </div>
    </div>
  )
}
