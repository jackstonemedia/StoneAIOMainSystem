// ─── BLOCK RENDERER ───────────────────────────────────────────────────────────
// Switch on block.type, render the matching component.
// The block component receives its typed block + an onUpdateContent callback.

function renderBlock(block: EmailBlock, onUpdateContent: (content: Partial<any>) => void) {
  switch (block.type) {
    case 'text':
      return <TextBlock block={block} onUpdateContent={onUpdateContent} />
    case 'heading':
      return <HeadingBlock block={block} onUpdateContent={onUpdateContent} />
    case 'image':
      return <ImageBlock block={block} onUpdateContent={onUpdateContent} />
    case 'button':
      return <ButtonBlock block={block} onUpdateContent={onUpdateContent} />
    case 'divider':
      return <DividerBlock block={block} />
    case 'spacer':
      return <SpacerBlock block={block} />
    case 'two-column':
    case 'three-column':
      return <ColumnsBlock block={block} onUpdateContent={onUpdateContent} />
    case 'bullet-list':
    case 'numbered-list':
      return <BulletListBlock block={block} onUpdateContent={onUpdateContent} />
    case 'video-thumbnail':
      return <VideoThumbnailBlock block={block} onUpdateContent={onUpdateContent} />
    case 'social-icons':
      return <SocialIconsBlock block={block} onUpdateContent={onUpdateContent} />
    case 'unsubscribe-footer':
      return <UnsubscribeFooterBlock block={block} onUpdateContent={onUpdateContent} />
  }
}
