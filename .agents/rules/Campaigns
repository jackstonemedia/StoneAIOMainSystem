import { useState } from 'react'
import { Sparkles, X } from 'lucide-react'
import { EmailBlock } from '../../types/emailCampaign'
import { streamText } from '../../lib/gemini'
import { createBlock } from '../../lib/emailCampaignUtils'
import { Button } from '../ui/Button'
import { useToast } from '../../context/ToastContext'
import { useConfirm } from '../../hooks/useConfirm'

interface Props {
  campaignName: string
  subject: string
  onGenerate: (blocks: EmailBlock[]) => void
  onClose: () => void
}

export function AIEmailModal({ campaignName, subject, onGenerate, onClose }: Props) {
  const [goal, setGoal] = useState('')
  const [loading, setLoading] = useState(false)
  const [streamedText, setStreamedText] = useState('')
  const { toast } = useToast()
  const { confirm } = useConfirm()

  async function handleGenerate() {
    if (!goal.trim()) return

    setLoading(true)
    setStreamedText('')

    try {
      // The prompt instructs Gemini to return a JSON array of block descriptors.
      // We parse these into actual EmailBlock objects.
      const prompt = `
You are an email marketing expert. Generate the content for a professional marketing email.

Campaign name: "${campaignName}"
Subject line: "${subject}"
Goal: ${goal}

Return ONLY a valid JSON array of block objects. No explanation, no markdown, no code fences.
Each block must have this exact structure based on type:

For a heading block: { "type": "heading", "level": "h1" | "h2", "text": "..." }
For a text block: { "type": "text", "html": "..." }
For a button block: { "type": "button", "text": "...", "url": "{{cta_url}}" }
For a divider: { "type": "divider" }
For a spacer: { "type": "spacer", "height": 24 }

Rules:
- Start with a compelling heading
- Write 2-3 text blocks with the email body
- Include exactly one button CTA
- Use {{first_name}} personalization token where natural
- End with a spacer
- Return 5-8 blocks total
- Make the copy persuasive and professional
`

      // We use generateJSON here instead of streaming because we need the full
      // JSON to be valid before parsing. Streaming partial JSON would fail.
      const { generateJSON } = await import('../../lib/gemini')

      const rawBlocks = await generateJSON<{
        type: string; level?: string; text?: string; html?: string;
        url?: string; height?: number
      }[]>(prompt, 'Return only valid JSON array')

      // Convert AI-returned descriptors to real EmailBlock objects
      const blocks: EmailBlock[] = rawBlocks.map(b => {
        switch (b.type) {
          case 'heading': {
            const block = createBlock('heading') as any
            block.content.html = b.text || 'Heading'
            block.content.level = b.level || 'h2'
            return block
          }
          case 'text': {
            const block = createBlock('text') as any
            block.content.html = b.html || b.text || 'Text'
            return block
          }
          case 'button': {
            const block = createBlock('button') as any
            block.content.text = b.text || 'Click Here'
            block.content.url = b.url || ''
            return block
          }
          case 'divider': return createBlock('divider')
          case 'spacer': {
            const block = createBlock('spacer') as any
            block.styles.height = b.height || 24
            return block
          }
          default: return createBlock('text')
        }
      })

      onGenerate(blocks)
      toast.success('Email generated successfully')

    } catch (err) {
      toast.error('Failed to generate email. Check your Gemini API key.')
    } finally {
      setLoading(false)
    }
  }

  return (
    // Fixed overlay — full screen modal
    <div className="fixed inset-0 z-50 flex items-center justify-center bg-black/50" onClick={onClose}>
      <div className="bg-white rounded-xl shadow-2xl w-full max-w-lg p-6" onClick={e => e.stopPropagation()}>
        <div className="flex items-center justify-between mb-4">
          <div className="flex items-center gap-2">
            <Sparkles size={20} className="text-purple-500" />
            <h2 className="font-semibold text-gray-900">Generate Email with AI</h2>
          </div>
          <button onClick={onClose} className="text-gray-400 hover:text-gray-600">
            <X size={20} />
          </button>
        </div>

        <p className="text-sm text-gray-600 mb-4">
          Describe your campaign goal and AI will generate the full email content.
          This will replace any existing blocks.
        </p>

        <textarea
          value={goal}
          onChange={e => setGoal(e.target.value)}
          placeholder="e.g. Announce our summer sale with 30% off, encourage customers to shop our new collection..."
          rows={4}
          className="w-full px-4 py-3 border border-gray-200 rounded-lg text-sm focus:outline-none focus:ring-2 focus:ring-purple-500 resize-none"
          autoFocus
        />

        <div className="flex justify-end gap-3 mt-4">
          <Button variant="ghost" onClick={onClose}>Cancel</Button>
          <Button
            onClick={handleGenerate}
            disabled={!goal.trim() || loading}
            className="bg-purple-600 hover:bg-purple-700"
          >
            {loading ? 'Generating...' : 'Generate Email'}
          </Button>
        </div>
      </div>
    </div>
  )
}
