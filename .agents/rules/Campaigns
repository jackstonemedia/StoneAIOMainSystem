// ─── Recipient resolution ────────────────────────────────────────────────────────
// Takes the RecipientConfig from Step 1 and returns the actual contacts
// that will receive this campaign. Used for both the live count display
// and for building the recipientTracking array when sending.

export function resolveRecipients(config: RecipientConfig): Contact[] {
  const allContacts = db.get<Contact>('CONTACTS')

  switch (config.type) {
    case 'all':
      return allContacts

    case 'segment': {
      // Import evaluateSegment from segmentEngine
      // The segment has its rules stored in SEGMENTS
      const segments = db.get<any>('SEGMENTS')
      const segment = segments.find((s: any) => s.id === config.segmentId)
      if (!segment) return []
      const { evaluateSegment } = require('./segmentEngine')
      return evaluateSegment(segment.rules, segment.conjunction, allContacts)
    }

    case 'tag':
      return allContacts.filter(c => c.tags?.includes(config.tagId))

    case 'manual':
      return allContacts.filter(c => config.contactIds.includes(c.id))
  }
}

export function getRecipientCount(config: RecipientConfig): number {
  return resolveRecipients(config).length
}

// ─── Personalization token replacement ──────────────────────────────────────────
// Called when rendering a preview with a specific contact's data,
// or theoretically at send time with each recipient's data.

export function replaceTokens(html: string, contact: Contact, unsubscribeUrl = '#'): string {
  return html
    .replace(/\{\{first_name\}\}/g, contact.firstName || '')
    .replace(/\{\{last_name\}\}/g, contact.lastName || '')
    .replace(/\{\{company\}\}/g, contact.company || '')
    .replace(/\{\{email\}\}/g, contact.email || '')
    .replace(/\{\{unsubscribe_link\}\}/g, unsubscribeUrl)
}

// ─── Block HTML renderer ─────────────────────────────────────────────────────────
// Converts the blocks array into a single HTML string.
// Used for: preview rendering, export, sending via integration.

export function renderBlocksToHTML(blocks: EmailBlock[], emailStyles: EmailCampaign['emailStyles']): string {
  const blocksHTML = blocks.map(renderBlockToHTML).join('\n')

  return `
    <div style="background-color:${emailStyles.backgroundColor};padding:20px 0;font-family:${emailStyles.fontFamily}">
      <div style="max-width:${emailStyles.maxWidth}px;margin:0 auto;background-color:${emailStyles.contentBackgroundColor}">
        ${blocksHTML}
      </div>
    </div>
  `
}

function renderBlockToHTML(block: EmailBlock): string {
  switch (block.type) {
    case 'text':
      return `<div style="${styleObj({
        fontSize: block.styles.fontSize + 'px',
        color: block.styles.color,
        backgroundColor: block.styles.backgroundColor,
        padding: `${block.styles.paddingTop}px ${block.styles.paddingRight}px ${block.styles.paddingBottom}px ${block.styles.paddingLeft}px`,
        textAlign: block.styles.textAlign,
        lineHeight: block.styles.lineHeight,
      })}">${block.content.html}</div>`

    case 'heading':
      const Tag = block.content.level
      return `<${Tag} style="${styleObj({
        fontSize: block.styles.fontSize + 'px',
        color: block.styles.color,
        backgroundColor: block.styles.backgroundColor,
        padding: `${block.styles.paddingTop}px ${block.styles.paddingRight}px ${block.styles.paddingBottom}px ${block.styles.paddingLeft}px`,
        textAlign: block.styles.textAlign,
        fontWeight: block.styles.fontWeight,
        margin: 0,
      })}">${block.content.html}</${Tag}>`

    case 'image': {
      const img = `<img src="${block.content.src}" alt="${block.content.alt}" style="max-width:100%;display:block;border-radius:${block.styles.borderRadius}px">`
      const wrapped = block.content.linkUrl ? `<a href="${block.content.linkUrl}">${img}</a>` : img
      return `<div style="text-align:${block.styles.alignment};padding:${block.styles.paddingTop}px 0 ${block.styles.paddingBottom}px">${wrapped}</div>`
    }

    case 'button': {
      const align = block.styles.alignment === 'center' ? 'margin:0 auto' : block.styles.alignment === 'right' ? 'margin-left:auto' : ''
      return `<div style="padding:${block.styles.paddingTop}px 0 ${block.styles.paddingBottom}px;text-align:${block.styles.alignment}">
        <a href="${block.content.url}" style="${styleObj({
          display: 'inline-block',
          backgroundColor: block.styles.backgroundColor,
          color: block.styles.textColor,
          padding: `${block.styles.paddingTop}px ${block.styles.paddingRight}px ${block.styles.paddingBottom}px ${block.styles.paddingLeft}px`,
          borderRadius: block.styles.borderRadius + 'px',
          fontSize: block.styles.fontSize + 'px',
          fontWeight: block.styles.fontWeight,
          textDecoration: 'none',
          width: block.styles.width === 'full' ? '100%' : 'auto',
        })}">${block.content.text}</a></div>`
    }

    case 'divider':
      return `<hr style="${styleObj({
        border: 'none',
        borderTop: `${block.styles.thickness}px ${block.styles.style} ${block.styles.color}`,
        margin: `${block.styles.marginTop}px 0 ${block.styles.marginBottom}px`,
      })}">`

    case 'spacer':
      return `<div style="height:${block.styles.height}px"></div>`

    case 'bullet-list':
    case 'numbered-list': {
      const ListTag = block.type === 'bullet-list' ? 'ul' : 'ol'
      const items = block.content.items.map(item => `<li>${item}</li>`).join('')
      return `<${ListTag} style="${styleObj({
        fontSize: block.styles.fontSize + 'px',
        color: block.styles.color,
        backgroundColor: block.styles.backgroundColor,
        padding: `${block.styles.paddingTop}px ${block.styles.paddingLeft}px ${block.styles.paddingBottom}px`,
        lineHeight: block.styles.lineHeight,
        margin: 0,
      })}">${items}</${ListTag}>`
    }

    case 'video-thumbnail':
      return `<div style="text-align:${block.styles.alignment};padding:${block.styles.paddingTop}px 0 ${block.styles.paddingBottom}px">
        <a href="${block.content.videoUrl}" style="position:relative;display:inline-block">
          <img src="${block.content.thumbnailUrl}" alt="${block.content.altText}" style="max-width:100%;border-radius:${block.styles.borderRadius}px">
          <div style="position:absolute;top:50%;left:50%;transform:translate(-50%,-50%);width:60px;height:60px;background:rgba(0,0,0,0.6);border-radius:50%;display:flex;align-items:center;justify-content:center">
            <div style="border-left:20px solid white;border-top:12px solid transparent;border-bottom:12px solid transparent;margin-left:4px"></div>
          </div>
        </a></div>`

    case 'social-icons': {
      const icons = block.content.links.map(link => {
        const label = link.platform.charAt(0).toUpperCase() + link.platform.slice(1)
        return `<a href="${link.url}" style="display:inline-block;margin:0 ${block.styles.gap/2}px;color:${block.styles.color};font-size:${block.styles.iconSize}px;text-decoration:none">${label}</a>`
      }).join('')
      return `<div style="text-align:${block.styles.alignment};padding:${block.styles.paddingTop}px 0 ${block.styles.paddingBottom}px">${icons}</div>`
    }

    case 'unsubscribe-footer':
      return `<div style="${styleObj({
        fontSize: block.styles.fontSize + 'px',
        color: block.styles.color,
        backgroundColor: block.styles.backgroundColor,
        textAlign: block.styles.textAlign,
        padding: `${block.styles.paddingTop}px 24px ${block.styles.paddingBottom}px`,
      })}">${block.content.text}</div>`

    case 'two-column':
    case 'three-column': {
      const cols = block.content.columns
      const width = block.type === 'two-column' ? '50%' : '33.33%'
      const colsHTML = cols.map(colBlocks =>
        `<td style="width:${width};vertical-align:top;padding:0 ${block.styles.gap/2}px">${colBlocks.map(renderBlockToHTML).join('')}</td>`
      ).join('')
      return `<div style="padding:${block.styles.paddingTop}px 0 ${block.styles.paddingBottom}px;background:${block.styles.backgroundColor}">
        <table style="width:100%;border-collapse:collapse"><tr>${colsHTML}</tr></table></div>`
    }
  }
}

// Converts an object of CSS properties to an inline style string
function styleObj(obj: Record<string, string | number>): string {
  return Object.entries(obj)
    .filter(([, v]) => v !== undefined && v !== '')
    .map(([k, v]) => `${camelToKebab(k)}:${v}`)
    .join(';')
}

function camelToKebab(str: string): string {
  return str.replace(/[A-Z]/g, letter => `-${letter.toLowerCase()}`)
}

