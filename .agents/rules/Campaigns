import { TextBlock as TextBlockType } from '../../../types/emailCampaign'
import { TokenInserter } from '../TokenInserter'

export function TextBlock({ block, onUpdateContent }: {
  block: TextBlockType
  onUpdateContent: (c: Partial<TextBlockType['content']>) => void
}) {
  const ref = useRef<HTMLDivElement>(null)

  // contentEditable div: inline editing without a library.
  // We store HTML (innerHTML) so bold/italic from formatting survives.
  // onInput fires on every keystroke and syncs to state.
  // NOTE: we use onInput not onChange — React's onChange on contentEditable
  // is unreliable. onInput is the correct native event.

  function handleInput() {
    if (!ref.current) return
    onUpdateContent({ html: ref.current.innerHTML })
  }

  // Format commands — executes browser's built-in execCommand.
  // Works inside contentEditable divs.
  function format(command: string, value?: string) {
    document.execCommand(command, false, value)
    ref.current?.focus()
    handleInput()
  }

  function insertToken(token: string) {
    document.execCommand('insertText', false, token)
    handleInput()
  }

  return (
    <div style={{
      padding: `${block.styles.paddingTop}px ${block.styles.paddingRight}px ${block.styles.paddingBottom}px ${block.styles.paddingLeft}px`,
      backgroundColor: block.styles.backgroundColor,
    }}>
      {/* Mini formatting toolbar — appears above the editable area */}
      <div className="flex gap-1 mb-1 p-1 bg-gray-100 rounded text-xs">
        <button onMouseDown={e => { e.preventDefault(); format('bold') }}
          className="px-1.5 py-0.5 hover:bg-gray-200 rounded font-bold">B</button>
        <button onMouseDown={e => { e.preventDefault(); format('italic') }}
          className="px-1.5 py-0.5 hover:bg-gray-200 rounded italic">I</button>
        <button onMouseDown={e => { e.preventDefault(); format('underline') }}
          className="px-1.5 py-0.5 hover:bg-gray-200 rounded underline">U</button>
        <div className="w-px bg-gray-300 mx-1" />
        <button onMouseDown={e => { e.preventDefault(); format('justifyLeft') }}
          className="px-1.5 py-0.5 hover:bg-gray-200 rounded">L</button>
        <button onMouseDown={e => { e.preventDefault(); format('justifyCenter') }}
          className="px-1.5 py-0.5 hover:bg-gray-200 rounded">C</button>
        <button onMouseDown={e => { e.preventDefault(); format('justifyRight') }}
          className="px-1.5 py-0.5 hover:bg-gray-200 rounded">R</button>
        <div className="w-px bg-gray-300 mx-1" />
        {/* Token inserter — dropdown of {{first_name}} etc */}
        <TokenInserter onInsert={insertToken} />
      </div>

      <div
        ref={ref}
        contentEditable
        suppressContentEditableWarning
        dangerouslySetInnerHTML={{ __html: block.content.html }}
        onInput={handleInput}
        style={{
          fontSize: block.styles.fontSize + 'px',
          color: block.styles.color,
          textAlign: block.styles.textAlign,
          lineHeight: block.styles.lineHeight,
          outline: 'none',
          minHeight: '1em',
          whiteSpace: 'pre-wrap',
        }}
      />
    </div>
  )
}
