import { Button } from '../../../components/ui/Button'

interface Props {
  blocks: EmailBlock[]
  emailStyles: EmailCampaign['emailStyles']
  onSetBlocks: (blocks: EmailBlock[]) => void
  onUpdateBlock: (id: string, changes: Partial<EmailBlock>) => void
  onUpdateBlockContent: (id: string, content: Partial<any>) => void
  onUpdateBlockStyles: (id: string, styles: Partial<any>) => void
  onDeleteBlock: (id: string) => void
  onInsertBlock: (block: EmailBlock, atIndex: number) => void
  onMoveBlock: (from: number, to: number) => void
  onUpdateEmailStyles: (styles: Partial<EmailCampaign['emailStyles']>) => void
  campaignName: string
  subject: string
}

export function Step2Designer({
  blocks, emailStyles, onSetBlocks, onUpdateBlock,
  onUpdateBlockContent, onUpdateBlockStyles, onDeleteBlock,
  onInsertBlock, onMoveBlock, onUpdateEmailStyles,
  campaignName, subject
}: Props) {
  // ─── STATE ────────────────────────────────────────────────────────────────
  const [selectedBlockId, setSelectedBlockId] = useState<string | null>(null)
  const [previewMode, setPreviewMode] = useState<'desktop' | 'mobile'>('desktop')
  const [showAIEmailModal, setShowAIEmailModal] = useState(false)
  const [showAISubjectModal, setShowAISubjectModal] = useState(false)

  // ─── UNDO / REDO ──────────────────────────────────────────────────────────
  // History is a ref (not state) to avoid re-renders on push.
  // historyIndex points to the current position in the history stack.
  // On every block change, the current blocks are pushed to history.
  // Undo pops the stack; redo moves forward if there's a future state.

  const history = useRef<EmailBlock[][]>([blocks])
  const historyIndex = useRef<number>(0)

  // Called by EmailCanvas whenever blocks array changes
  const handleBlocksChange = useCallback((newBlocks: EmailBlock[]) => {
    // Truncate any "future" states (user had undone and is now making a new change)
    history.current = history.current.slice(0, historyIndex.current + 1)
    // Push new state — keep max 50 entries
    history.current.push(newBlocks)
    if (history.current.length > 50) history.current.shift()
    historyIndex.current = history.current.length - 1
    onSetBlocks(newBlocks)
  }, [onSetBlocks])

  function handleUndo() {
    if (historyIndex.current <= 0) return
    historyIndex.current--
    onSetBlocks(history.current[historyIndex.current])
    setSelectedBlockId(null)
  }

  function handleRedo() {
    if (historyIndex.current >= history.current.length - 1) return
    historyIndex.current++
    onSetBlocks(history.current[historyIndex.current])
  }

  // Keyboard shortcuts
  useEffect(() => {
    function handleKey(e: KeyboardEvent) {
      const mod = e.metaKey || e.ctrlKey
      if (mod && e.key === 'z' && !e.shiftKey) { e.preventDefault(); handleUndo() }
      if (mod && (e.key === 'y' || (e.key === 'z' && e.shiftKey))) { e.preventDefault(); handleRedo() }
    }
    window.addEventListener('keydown', handleKey)
    return () => window.removeEventListener('keydown', handleKey)
  }, [])

  // ─── SELECTED BLOCK ───────────────────────────────────────────────────────
  const selectedBlock = selectedBlockId
    ? blocks.find(b => b.id === selectedBlockId) ?? null
    : null

  // ─── RENDER ───────────────────────────────────────────────────────────────
  return (
    <div className="flex h-full">

      {/* Left: Block palette (200px fixed) */}
      <div className="w-[200px] flex-shrink-0 border-r border-gray-200 bg-white overflow-y-auto">
        <BlockPalette />
      </div>

      {/* Center: Canvas + toolbar */}
      <div className="flex-1 flex flex-col">

        {/* Toolbar */}
        <div className="flex items-center gap-3 px-4 py-2 bg-white border-b border-gray-200">
          {/* Preview toggle */}
          <div className="flex items-center border border-gray-200 rounded-lg overflow-hidden">
            <button
              onClick={() => setPreviewMode('desktop')}
              className={`px-3 py-1.5 text-sm flex items-center gap-1.5 ${
                previewMode === 'desktop' ? 'bg-blue-600 text-white' : 'text-gray-600 hover:bg-gray-50'
              }`}
            >
              <Monitor size={14} /> Desktop
            </button>
            <button
              onClick={() => setPreviewMode('mobile')}
              className={`px-3 py-1.5 text-sm flex items-center gap-1.5 ${
                previewMode === 'mobile' ? 'bg-blue-600 text-white' : 'text-gray-600 hover:bg-gray-50'
              }`}
            >
              <Smartphone size={14} /> Mobile
            </button>
          </div>

          {/* Undo / Redo */}
          <button onClick={handleUndo} className="p-1.5 text-gray-400 hover:text-gray-700 disabled:opacity-30" title="Undo (⌘Z)">
            <Undo2 size={16} />
          </button>
          <button onClick={handleRedo} className="p-1.5 text-gray-400 hover:text-gray-700" title="Redo (⌘Y)">
            <Redo2 size={16} />
          </button>

          <div className="w-px h-5 bg-gray-200" />

          {/* AI buttons */}
          <Button variant="ghost" size="sm" onClick={() => setShowAIEmailModal(true)}>
            <Sparkles size={14} className="mr-1 text-purple-500" /> Generate Email
          </Button>
          <Button variant="ghost" size="sm" onClick={() => setShowAISubjectModal(true)}>
            <Sparkles size={14} className="mr-1 text-purple-500" /> Improve Subject
          </Button>
        </div>

        {/* Canvas scroll area */}
        <div
          className="flex-1 overflow-y-auto bg-gray-100 p-8"
          onClick={() => setSelectedBlockId(null)} // click outside block deselects
        >
          <EmailCanvas
            blocks={blocks}
            emailStyles={emailStyles}
            selectedBlockId={selectedBlockId}
            previewWidth={previewMode === 'desktop' ? emailStyles.maxWidth : 375}
            onSelectBlock={setSelectedBlockId}
            onBlocksChange={handleBlocksChange}
            onUpdateBlockContent={onUpdateBlockContent}
            onDeleteBlock={onDeleteBlock}
            onInsertBlock={onInsertBlock}
            onMoveBlock={onMoveBlock}
          />
        </div>
      </div>

      {/* Right: Properties panel (280px fixed) */}
      <div className="w-[280px] flex-shrink-0 border-l border-gray-200 bg-white overflow-y-auto">
