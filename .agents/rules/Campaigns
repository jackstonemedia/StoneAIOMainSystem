import { useState, useEffect } from 'react'
import { useParams, useNavigate } from 'react-router-dom'
import { ArrowLeft, Download } from 'lucide-react'
import { db } from '../../lib/storage'
import { EmailCampaign, RecipientTracking } from '../../types/emailCampaign'
import { useToast } from '../../context/ToastContext'
import { exportCSV } from '../../lib/csv'
import { Button } from '../../components/ui/Button'
import { formatDate } from '../../lib/format'

export default function CampaignAnalyticsPage() {
  const { id } = useParams<{ id: string }>()
  const navigate = useNavigate()
  const { toast } = useToast()

  const [campaign, setCampaign] = useState<EmailCampaign | null>(null)

  useEffect(() => {
    if (!id) return
    const c = db.findById<EmailCampaign>('EMAIL_CAMPAIGNS', id)
    if (!c) { toast.error('Campaign not found'); navigate('/marketing/email'); return }
    setCampaign(c)
  }, [id])

  if (!campaign) return null

  // ─── CALCULATED RATES ─────────────────────────────────────────────────────
  const { stats } = campaign
  const deliveredRate = stats.recipients > 0 ? ((stats.delivered / stats.recipients) * 100).toFixed(1) : '—'
  const openRate      = stats.delivered > 0  ? ((stats.opened / stats.delivered) * 100).toFixed(1) : '—'
  const clickRate     = stats.delivered > 0  ? ((stats.clicked / stats.delivered) * 100).toFixed(1) : '—'
  const unsubRate     = stats.delivered > 0  ? ((stats.unsubscribed / stats.delivered) * 100).toFixed(1) : '—'
  const bounceRate    = stats.recipients > 0 ? ((stats.bounced / stats.recipients) * 100).toFixed(1) : '—'

  const KPI_CARDS = [
    { label: 'Recipients',   value: stats.recipients.toLocaleString(), sub: '100%' },
    { label: 'Delivered',    value: stats.delivered.toLocaleString(),  sub: `${deliveredRate}%` },
    { label: 'Opened',       value: stats.opened.toLocaleString(),     sub: `${openRate}% open rate` },
    { label: 'Clicked',      value: stats.clicked.toLocaleString(),    sub: `${clickRate}% click rate` },
    { label: 'Unsubscribed', value: stats.unsubscribed.toLocaleString(), sub: `${unsubRate}%` },
    { label: 'Bounced',      value: stats.bounced.toLocaleString(),    sub: `${bounceRate}%` },
  ]

  // ─── MANUAL STATS UPDATE ──────────────────────────────────────────────────
  // Lets the user paste stats from their sending provider
  function handleStatsUpdate(field: keyof typeof stats, value: string) {
    const num = parseInt(value) || 0
    const updated = { ...campaign.stats, [field]: num }
    db.update<EmailCampaign>('EMAIL_CAMPAIGNS', campaign.id, { stats: updated })
    setCampaign(prev => prev ? { ...prev, stats: updated } : prev)
  }

  // ─── RECIPIENT STATUS UPDATE ──────────────────────────────────────────────
  function updateRecipientStatus(contactId: string, status: RecipientTracking['status']) {
    const updated = campaign.recipientTracking.map(r =>
      r.contactId === contactId ? { ...r, status, lastEventAt: new Date().toISOString() } : r
    )
    db.update<EmailCampaign>('EMAIL_CAMPAIGNS', campaign.id, { recipientTracking: updated })
    setCampaign(prev => prev ? { ...prev, recipientTracking: updated } : prev)
  }

  // ─── EXPORT ───────────────────────────────────────────────────────────────
  function handleExport() {
    exportCSV(
      campaign.recipientTracking.map(r => ({
        Email: r.email,
        Status: r.status,
        'Last Event': r.lastEventAt ? formatDate(r.lastEventAt) : '',
      })),
      `${campaign.name}-recipients.csv`
    )
  }

  // ─── CHART ────────────────────────────────────────────────────────────────
  // Simple SVG line chart for opens/clicks over time.
  // Data comes from campaign.stats.timeline.

  function renderChart() {
    const data = stats.timeline
    if (data.length === 0) return (
      <div className="h-48 flex items-center justify-center text-sm text-gray-400">
        No timeline data yet
      </div>
    )

    const width = 600
    const height = 160
    const padding = { top: 10, right: 10, bottom: 30, left: 40 }
    const chartW = width - padding.left - padding.right
    const chartH = height - padding.top - padding.bottom
    const maxVal = Math.max(...data.map(d => Math.max(d.opens, d.clicks)), 1)

    function xPos(i: number) { return padding.left + (i / (data.length - 1)) * chartW }
    function yPos(v: number) { return padding.top + chartH - (v / maxVal) * chartH }

    const opensPath = data.map((d, i) => `${i === 0 ? 'M' : 'L'} ${xPos(i)} ${yPos(d.opens)}`).join(' ')
    const clicksPath = data.map((d, i) => `${i === 0 ? 'M' : 'L'} ${xPos(i)} ${yPos(d.clicks)}`).join(' ')

    return (
      <svg viewBox={`0 0 ${width} ${height}`} className="w-full">
        {/* Y-axis labels */}
        {[0, Math.ceil(maxVal/2), maxVal].map((v, i) => (
          <text key={i} x={padding.left - 6} y={yPos(v) + 4} textAnchor="end" fontSize={11} fill="#9ca3af">{v}</text>
        ))}
        {/* Grid lines */}
        {[0, 0.5, 1].map((pct, i) => (
          <line key={i} x1={padding.left} x2={width - padding.right}
            y1={padding.top + chartH * (1 - pct)} y2={padding.top + chartH * (1 - pct)}
            stroke="#f3f4f6" strokeWidth={1} />
        ))}
        {/* Opens line */}
        <path d={opensPath} fill="none" stroke="#3b82f6" strokeWidth={2} strokeLinejoin="round" />
        {/* Clicks line */}
        <path d={clicksPath} fill="none" stroke="#10b981" strokeWidth={2} strokeLinejoin="round" />
        {/* X-axis labels */}
        {data.map((d, i) => (
          i % Math.ceil(data.length / 6) === 0 && (
            <text key={i} x={xPos(i)} y={height - 4} textAnchor="middle" fontSize={10} fill="#9ca3af">
              {d.label}
            </text>
          )
        ))}
        {/* Legend */}
        <circle cx={padding.left + 8} cy={height - 14} r={4} fill="#3b82f6" />
        <text x={padding.left + 16} y={height - 10} fontSize={11} fill="#6b7280">Opens</text>
        <circle cx={padding.left + 70} cy={height - 14} r={4} fill="#10b981" />
        <text x={padding.left + 78} y={height - 10} fontSize={11} fill="#6b7280">Clicks</text>
      </svg>
    )
  }

  // ─── RENDER ───────────────────────────────────────────────────────────────
  return (
    <div className="p-6 max-w-6xl">

      {/* Header */}
      <div className="flex items-center gap-4 mb-6">
        <button onClick={() => navigate('/marketing/email')} className="text-gray-400 hover:text-gray-600">
          <ArrowLeft size={20} />
        </button>
        <div>
          <h1 className="text-2xl font-semibold text-gray-900">{campaign.name}</h1>
          <p className="text-sm text-gray-500">
            Sent {campaign.sentAt ? formatDate(campaign.sentAt) : '—'} · {campaign.subject}
          </p>
        </div>
      </div>

      {/* KPI cards */}
      <div className="grid grid-cols-6 gap-4 mb-8">
        {KPI_CARDS.map(card => (
          <div key={card.label} className="bg-white border border-gray-200 rounded-xl p-4">
            <p className="text-xs text-gray-500 mb-1">{card.label}</p>
            <p className="text-2xl font-semibold text-gray-900">{card.value}</p>
            <p className="text-xs text-gray-400 mt-0.5">{card.sub}</p>
          </div>
        ))}
      </div>

      {/* Chart */}
      <div className="bg-white border border-gray-200 rounded-xl p-6 mb-6">
        <h2 className="font-medium text-gray-900 mb-4">Opens & Clicks Over Time</h2>
        {renderChart()}
      </div>

      {/* Manual stats entry — shown when no integration connected */}
      <div className="bg-amber-50 border border-amber-200 rounded-xl p-6 mb-6">
        <h2 className="font-medium text-gray-900 mb-1">Record Delivery Stats</h2>
        <p className="text-sm text-gray-600 mb-4">
          If you sent via an external tool, enter the stats here manually. These update the rates above.
        </p>
        <div className="grid grid-cols-3 gap-4">
          {(['delivered','opened','clicked','unsubscribed','bounced'] as const).map(field => (
            <label key={field} className="block">
              <span className="text-sm text-gray-700 capitalize">{field}</span>
              <input
                type="number" min={0} value={stats[field]}
                onChange={e => handleStatsUpdate(field, e.target.value)}
                className="mt-1 w-full px-3 py-2 text-sm border border-gray-200 rounded-lg"
              />
            </label>
          ))}
        </div>
      </div>

      {/* Recipient table */}
      <div className="bg-white border border-gray-200 rounded-xl overflow-hidden">
        <div className="flex items-center justify-between px-6 py-4 border-b border-gray-200">
          <h2 className="font-medium text-gray-900">
            Recipients ({campaign.recipientTracking.length.toLocaleString()})
          </h2>
          <Button variant="ghost" size="sm" onClick={handleExport}>
            <Download size={16} className="mr-1" /> Export CSV
          </Button>
        </div>

        <div className="overflow-x-auto">
          <table className="w-full text-sm">
            <thead className="bg-gray-50 border-b border-gray-200">
              <tr>
                <th className="text-left px-6 py-3 text-xs font-medium text-gray-500 uppercase">Contact</th>
                <th className="text-left px-6 py-3 text-xs font-medium text-gray-500 uppercase">Email</th>
                <th className="text-left px-6 py-3 text-xs font-medium text-gray-500 uppercase">Status</th>
                <th className="text-left px-6 py-3 text-xs font-medium text-gray-500 uppercase">Last Event</th>
              </tr>
            </thead>
            <tbody className="divide-y divide-gray-100">
              {campaign.recipientTracking.map(recipient => {
                // Resolve contact name from contacts store
                const contact = db.findById<any>('CONTACTS', recipient.contactId)

                return (
                  <tr key={recipient.contactId} className="hover:bg-gray-50">
                    <td className="px-6 py-3 font-medium text-gray-900">
                      {contact ? `${contact.firstName} ${contact.lastName}` : '—'}
                    </td>
                    <td className="px-6 py-3 text-gray-600">{recipient.email}</td>
                    <td className="px-6 py-3">
                      {/* Status is an updatable dropdown — user marks from their provider's report */}
                      <select
                        value={recipient.status}
                        onChange={e => updateRecipientStatus(recipient.contactId, e.target.value as any)}
                        className={`text-xs px-2 py-1 rounded-full border-0 font-medium cursor-pointer ${
                          recipient.status === 'clicked'      ? 'bg-green-100 text-green-800' :
                          recipient.status === 'opened'       ? 'bg-blue-100 text-blue-800' :
                          recipient.status === 'delivered'    ? 'bg-gray-100 text-gray-800' :
                          recipient.status === 'unsubscribed' ? 'bg-orange-100 text-orange-800' :
                          recipient.status === 'bounced'      ? 'bg-red-100 text-red-800' :
                          'bg-gray-100 text-gray-600'
                        }`}
                      >
                        <option value="pending">Pending</option>
                        <option value="delivered">Delivered</option>
                        <option value="opened">Opened</option>
                        <option value="clicked">Clicked</option>
                        <option value="unsubscribed">Unsubscribed</option>
                        <option value="bounced">Bounced</option>
                      </select>
                    </td>
                    <td className="px-6 py-3 text-gray-500">
                      {recipient.lastEventAt ? formatDate(recipient.lastEventAt) : '—'}
                    </td>
                  </tr>
                )
              })}
            </tbody>
          </table>
        </div>
      </div>
    </div>
  )
}
